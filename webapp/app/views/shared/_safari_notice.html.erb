<%# Hidden until safari_notice_controller.js confirms the browser is Safari and the notice has not been dismissed. %>
<div class="alert alert-info alert-dismissible safari-notice" role="region" aria-label="Safari compatibility notice"
     data-controller="safari-notice" hidden>
  <p class="mb-1">
    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
    Some features of this site don’t work fully in Safari. For the best experience, try another browser such as Chrome or Firefox.
  </p>
  <details class="small">
    <summary>See more</summary>
    <p class="mt-2 mb-0">
      Search results and AI answers link to the page of a PDF where matching text was found. Safari’s
      built-in PDF viewer ignores the page in these links, so the document opens at its first page
      instead. You can still find the passage by scrolling to the page number shown with the excerpt.
    </p>
  </details>
  <button type="button" class="btn-close" aria-label="Dismiss" data-action="safari-notice#dismiss"></button>
</div>
