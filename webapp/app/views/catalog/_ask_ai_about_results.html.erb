<% has_results = @response&.documents.present? %>
<% hint = if has_results
            "Opens the AI chat with your search query, your facet selections, and this page of results, or only the results you select."
          else
            "Opens the AI assistant with your search and your filters."
          end %>
<% href = chat_path(search: ask_ai_search_params) %>
<section class="ask-ai-results" aria-labelledby="ask-ai-results-heading"
         data-controller="popover dock ask-ai-selection"
         data-ask-ai-selection-href-value="<%= href %>"
         data-action="change@document->ask-ai-selection#update">
  <h2 id="ask-ai-results-heading" class="visually-hidden">Ask AI about this search</h2>
  <div class="ask-ai-results-actions">
    <%= link_to href,
                class: "btn ask-ai-results-button",
                aria: { describedby: "ask-ai-results-hint" },
                data: { ask_ai_selection_target: "link" } do %>
      <%= render "shared/ai_icon", class_name: "ai-prompt-icon" %>
      <span><%= has_results ? "Ask AI about these results" : "Ask AI about this search" %></span>
    <% end %>
    <%= tag.button type: "button", id: "ask-ai-results-info",
                   class: "btn btn-link ask-ai-results-info",
                   aria: { label: "What gets sent to the AI chat" },
                   data: { popover_target: "trigger",
                           bs_toggle: "popover",
                           bs_placement: "top",
                           bs_title: "Send to chat",
                           bs_content: hint } do %>
      <i class="bi bi-info-circle" aria-hidden="true"></i>
    <% end %>
  </div>
  <%# Emptied rather than hidden at zero, so the live region is already in place to announce the first selection. %>
  <p class="ask-ai-results-selection" data-ask-ai-selection-target="status" aria-live="polite"></p>
  <p id="ask-ai-results-hint" class="visually-hidden"><%= hint %></p>
</section>
