<section class="alert alert-info ai-summary" aria-labelledby="ai-summary-heading"
         data-controller="ai-summary"
         data-ai-summary-url-value="<%= search_summary_path %>"
         data-ai-summary-token-value="<%= SearchSummary.token(query: params[:q], documents: documents) %>">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="ai-summary-title">
      <h2 id="ai-summary-heading" class="ai-summary-heading"><span aria-hidden="true">✦</span> ABOUT THESE RESULTS</h2>
      <em>AI-generated summary of the <%= pluralize(documents.size, "result") %> on this page</em>
    </div>
    <button type="button" class="btn-close" aria-label="Dismiss AI summary" data-action="ai-summary#dismiss"></button>
  </div>
  <%# Server-rendered so it paints before Stimulus connects. %>
  <div class="skeleton placeholder-glow" aria-hidden="true" data-ai-summary-target="skeleton">
    <span class="placeholder col-12"></span>
    <span class="placeholder col-12"></span>
    <span class="placeholder col-11"></span>
    <span class="placeholder col-12"></span>
    <span class="placeholder col-7"></span>
  </div>
  <div id="ai-summary-content" class="ai-summary-content" data-ai-summary-target="content" hidden></div>
  <%# Caption and toggle share one grid cell; see .ai-summary-footer. %>
  <div class="ai-summary-footer mt-3">
    <button type="button" class="btn ai-summary-toggle invisible" data-ai-summary-target="toggle"
            data-action="ai-summary#toggle" aria-expanded="false" aria-controls="ai-summary-content">Show more</button>
    <p role="status" class="ai-summary-status text-body-secondary" data-ai-summary-target="status">Loading AI summary…</p>
  </div>
  <noscript>Enable JavaScript to load the AI summary.</noscript>
</section>
