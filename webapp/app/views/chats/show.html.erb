<% content_for :page_title, "Chat with the collections — #{application_name}" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "chat", "data-turbo-track": "dynamic" %>
<% end %>

<div class="chat-page py-4" data-controller="chat">
  <div class="mx-auto chat-shell">
    <header class="mb-4">
      <h1>Ask AI</h1>
      <p class="lead mb-2">Chat with the AI Collections Assistant about material in our digital collections.</p>
      <p class="text-body-secondary mb-0">
        This experimental system covers only part of our collections. The assistant searches this site’s catalog and document text, and will decline requests outside that scope.
      </p>
    </header>

    <div class="card shadow-sm">
      <div class="card-body chat-messages" role="log" aria-live="polite" aria-relevant="additions text"
           data-chat-target="messages">
        <article class="chat-message chat-message-assistant">
          <div class="chat-message-label">Collections Assistant</div>
          <div class="chat-message-content">What would you like to learn from the collections?</div>
        </article>
      </div>

      <div class="card-footer bg-body p-3">
        <div class="alert alert-danger d-none mb-3" role="alert" data-chat-target="error"></div>
        <%= form_with url: chat_path, method: :post, html: { data: { action: "submit->chat#submit", chat_target: "form" } } do |form| %>
          <%= form.label :message, "Your question", class: "form-label visually-hidden" %>
          <div class="search-query-form">
            <div class="input-group">
              <%= form.text_area :message,
                                 rows: 1,
                                 required: true,
                                 maxlength: Rails.configuration.x.chat.max_message_characters,
                                 placeholder: "Ask a question about people, places, themes, or documents...",
                                 class: "form-control search-q",
                                 data: { chat_target: "input", action: "keydown->chat#keydown" } %>
              <%= tag.button class: "btn btn-primary search-btn", type: "submit",
                             aria: { label: "Send" },
                             data: { chat_target: "submit" } do %>
                <span class="submit-search-text" aria-hidden="true" data-chat-target="submitLabel">Send</span>
              <% end %>
            </div>
          </div>
          <div class="form-text">This is an experimental system with limited data. AI may be inaccurate. Please verify important details against the cited sources.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
