<article class="card mb-3 w-25" data-controller='results' data-results-druid-value="<%= result.druid %>">
  <a href="https://purl.stanford.edu/<%= result.druid %>">
  <div class="canvas-container">
  <canvas data-results-target="canvas" width="100%" height="180">
    <svg class="bd-placeholder-img card-img-top" width="100%" height="180" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Placeholder: Image cap" preserveAspectRatio="xMidYMid slice" focusable="false"><title>Placeholder</title><rect width="100%" height="100%" fill="#868e96"></rect><text x="50%" y="50%" fill="#dee2e6" dy=".3em">Image cap</text></svg>
  </canvas>
  </div>

  <div class="card-body">
    <header class="card-title" data-results-target="title"><%= result.druid %></header>
    <p class="card-text" data-results-target="abstract"></p>
    <p class="card-text"><small class="text-body-secondary" data-results-target="date">Last updated 3 mins ago</small></p>
    <p class="card-text"><%= result.distance.round(4) %></p>
  </div>
  </a>
</article>
