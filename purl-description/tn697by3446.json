    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This model simulates water supply performance of the Hetch Hetchy Regional Water System focusing on the Tuolumne River system. The analysis considers two policy scenarios (Existing Bay-Delta Plan, Amended Bay-Delta Plan) over retrospective and prospective time windows. The prospective window includes eight hydrologic scenarios representing climate uncertainty.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
