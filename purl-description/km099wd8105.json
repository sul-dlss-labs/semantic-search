            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Lowrey, J., Rose, D., and Markman, E. (2024). The role of purpose in 5-9-year-old children's categorization . Stanford Digital Repository. Available at https://purl.stanford.edu/km099wd8105.",
