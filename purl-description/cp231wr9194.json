    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This folder contains the raw recordings that form the basis for the electrophysiological experiments in Figures 2, 3, 4 and 6 of Pei-Yi Lin et al., PNAS 2023. The recordings are deposited here because the original data source file provided in the paper contained innumerable errors that raised major concerns in the community about the validity of the data. Note that each file contains unalterable metadata that describe time and date of the recordings.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Lin, P. (2023). Neurexin-2 Restricts Synapse Numbers and Restrains the Presynaptic Release Probability by an Alternative Splicing-Dependent Mechanism. Stanford Digital Repository. Available at https://purl.stanford.edu/cp231wr9194. https://doi.org/10.25740/cp231wr9194.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
