    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This report shows that better land management can contribute to tackling climate change, but is not the only solution. Reducing greenhouse gas emissions from all sectors is essential if global warming is to be kept to well below 2ºC, if not 1.5ºC. The IPCC approved and accepted the report at its 50th Session held on 2 - 7 August 2019. The approved Summary for Policymakers (SPM) was presented at a press conference on 8 August 2019",
            "identifier": [],
            "note": [],
            "appliesTo": []
