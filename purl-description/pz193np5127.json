    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Somos Familia is an Oakland based organization that seeks to build acceptance within Latinx families, develop leadership among queer youth, and provide accessible bilingual education. Anna Perronne worked with the team on various fundraising initiatives and community events. This poster summarizes some of her work.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Perronne, A. and Roque, B. (2024). Building Latinx Queer Community with Somos Familia. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/pz193np5127/version/1. https://doi.org/10.25740/pz193np5127.",
