    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains Magnetohydrodynamic parameters calculated from the SHARP (Space weather HMI Active Region Patches) data series available from jsoc.stanford.edu. The files are named by the HARPNUM keyword and parameters are calculated for every 12 minutes of SHARP data. Along with the parameters, the information of whether a solar flare occured within +-1 hour of that timestamp is also embedded in keywords \"NUM_FLARES\" and \"FLARE_ID\" links these identified flares to their properties listed in goes_flares_integrated.csv. \r\n\r\nThis is version 0.2 of the dataset and contains parameters from the first 2000 HARPNUM of the SHARP data series. The version of the data will be updated as new records are uploaded.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mahajan, S. and Hoeksema, J. (2024). MHD Parameters of Solar Active Regions for Solar Flare Forecasting. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/jz065wt1927/version/1. https://doi.org/10.25740/jz065wt1927.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
