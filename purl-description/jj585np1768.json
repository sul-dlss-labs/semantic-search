    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data set (link below) is a compilation of the historical technology integration data including NAND Flash, DRAM, SRAM presented in ITRS, journals, and conferences including IEDM , VLSI Technology and ISSCC from 1988 and onward. This data set also contains CPU, GPU data from Intel, NVIDIA and AMD. W.-C. Chen, Haitong Li, Shengjun Qin, C.-H. Wang and H.-S. Philip Wong at Stanford University, Kerem Akarvardar at TSMC and Mohamed M. Sabry at Nanyang Technological University compiled the data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Wei-Chen Chen and Haitong Li and Shengjun Qin and Mohamed M. Sabry and Kerem Akarvardar and Ching-Hua Wang and H.-S. Philip Wong. (2020). Technology Integration Trend. Stanford Digital Repository. Available at: https://purl.stanford.edu/jj585np1768",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
