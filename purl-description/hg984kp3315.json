    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This capstone thesis examines the Buda Castle restoration project and interrogates the motivating forces behind it. This investigation into the drivers and aims of the project achieves two outcomes. The first is that it provides a clear depiction of the relationship between systemic corruption and idealistic nation building in Viktor Orbán’s autocratic “illiberal democracy.” The second is that it allows for conclusions to be drawn about the deeper nature of Orbán’s long reign and “what autocrats want,” more broadly. This paper is divided into three sections: the first examining the restoration project as a corrupt profiteering endeavor; the second examining it as a part of a long, dedicated project of revisionism and myth making; and the third examining the implications of the castle’s restoration more closely.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kisiday, M. (2024). Reconstructing the Castle upon the Hill: Corruption, Nation Building, and Historical Revisionism in Viktor Orbán’s Hungary. Stanford Digital Repository. Available at https://purl.stanford.edu/hg984kp3315. https://doi.org/10.25740/hg984kp3315.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
