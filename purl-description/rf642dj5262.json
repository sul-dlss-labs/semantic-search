    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Team Daimler has created a new product which will allow drivers more access to the center consoles of their cars without having to take their eyes off the road. The display will extend from the driver’s side to the passenger side and allow both driver and passenger to have control over various functions such as temperature volume and navigation.  The display will be able to change and display different sets of information based what the driver or the passenger wants to know.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
