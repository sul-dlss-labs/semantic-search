    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "LD4P3 (Linked data for production: closing the loop) team presenting on their integration of Wikidata information around musical works into a Cornell library catalog prototype with a focus on the Wikidata aspects of work. This two-part presentation took place at calls of the LD4 Discovery Affinity Group (2023-03-14) and the LD4 Wikidata Affinity Group (2023-03-21).",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Khan, H., Folsom, S., Usong, A., and Kishimoto, K. (2023). Browsing Across Music With Obtainable Wikidata (BAMWOW!). Stanford Digital Repository. Available at https://purl.stanford.edu/tn632gt4909. https://doi.org/10.25740/tn632gt4909.",
