    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This report is about a study that was performed to obtain mathematical correlations for equilibrium-ratios of a gas-condensate system. The data used in this study was obtained experimentally by Roland, Smith and Kaveler in 1941. The approach taken to correlate the data is one suggested by Hoffmann, Crurnp and Hocott. In this, log(Kp) is plotted against a component characterization factor. The family of curves thus obtained for different temperatures and pressures have been curve-fitted to yield a single equation. The applicability of this equation is for a temperature range of 40 F to 200 F and a pressure range of 100 psia to 1000 psia.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
