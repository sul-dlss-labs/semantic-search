    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Poster project overviewing summer research under the Race and Tech fellowship for the Center for Comparative Studies in Race and Ethnicity. \r\nThis research was completed alongside Indigenous communities in Oaxaca under grassroots organization SurcoOaxaca, and Kiado Cruz. It includes online resources on data protection, access to internet, and cultural preservation, along with testimonies on internet usage within Native communities.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Bolger Witherspoon, H. (2024). Digital Empowerment: Bridging Divides for Marginalized and Indigenous Communities in Oaxaca, Mexico, Race and Tech Fellowship. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/js382vn3358/version/1. https://doi.org/10.25740/js382vn3358.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
