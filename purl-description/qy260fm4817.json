            "parallelValue": [],
            "groupedValue": [],
            "value": "Abraham, A. and Mordecai, E. (2022). Early Warning Signal Detection for Ross River Virus in Queensland, Australia. Stanford Digital Repository. Available at https://purl.stanford.edu/qy260fm4817",
