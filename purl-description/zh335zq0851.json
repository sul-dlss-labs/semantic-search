    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Montage platform is a new digital environment that we are developing as part of an ongoing research-practice partnership with a school district that seeks to encourage teachers to pursue new forms of technology-mediated pedagogy and better retain institutional knowledge given teacher turnover. In Montage, the interface and features are designed to support “bite-sized” teacher learning through exposure to user generated content. This paper describes the current version of the platform, its design inspiration, relevant theory, features, and four deliberate strategies used to embed bite-sized teacher learning supports.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Lee, V. (2023). Bite-sized Learning for Teachers through the Montage Platform. Stanford Digital Repository. Available at https://purl.stanford.edu/zh335zq0851. https://doi.org/10.25740/zh335zq0851.",
            "type": "preferred citation",
            "identifier": [],
