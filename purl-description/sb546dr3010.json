    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This qualitative study explores how Indigenous knowledges and perspectives are positioned in early childhood education policy in British Columbia and Manitoba. Responding to the Truth and Reconciliation Commission's final report citing 94 calls to action, this study looks at the collective commitments outlined in national and provincial frameworks relating to improving relations with Indigenous peoples in Canada. I analyze 32 policy documents to better understand how discourses and priorities of early childhood education respond to the project of reconciliation. Findings reveal variances in discourse across and within provinces. These variances manifest as points of tension in curriculum and pedagogy, suggesting that the commitment to advancing reconciliation is not consistent throughout policy. This study provides a timely contribution to the ongoing expansion of early childhood education policy across Canada aiming to better comprehend the current trajectory of reconciliation should early childhood education policy continue to reinforce certain practices while discouraging others.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Chartrand, A. (2024). (Re)positioning Indigenous Knowledge and Perspectives in Early Childhood Education in British Columbia and Manitoba, Canada. Stanford Digital Repository. Available at https://purl.stanford.edu/sb546dr3010. https://doi.org/10.25740/sb546dr3010.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
