    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For algae in the upper intertidal zone, desiccation is one major stress that determines species fitness (Celia M. Smith & Berry, 1986). Here, I used lab experiments to examine desiccation in upper intertidal red alga species Mastocarpus papillatus and Porphyra perforata. Preliminary data gathered was inconclusive regarding the impact of collection site and species on changes in photosynthetic activity as measured by electron transport rate (ETR). As such, further research is proposed to take into account the small sample size of this initial dataset as well as other potential variables of interest, such as heat stress, wave action stress, vertical distribution across intertidal zones, and geographic distribution across latitudes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hafner, L. (2022). Desiccation in Mastocarpus papillatus and Porphyra perforata. Stanford Digital Repository.Final report for BIOHOPK47.  Available at https://purl.stanford.edu/nc685wy2906",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
