    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Concern over the achievement of this population of students has led to a large number of recent research reviews and professional publications aimed at improving preschool DLL's [dual language learners] educational opportunities. In this article, we survey the growing body of research to help inform educators responsible for creating settings for our young DLLs.\r\n\r\nWe organize our review of the research by addressing four key topics:\r\n\r\n1. Employing children's home language in the early childhood curriculum;\r\n2. Comparing effective practices for DLLs and English speakers in English-only programs;\r\n3. Promoting language development in English and the home language; and\r\n4. Involving families in supporting children's language learning.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Goldenberg, C., Hicks, J., & Lit, I. (2013). Dual Language Learners: Effective Instruction in Early Childhood. American Educator, 37(2), 26-29.",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        }
