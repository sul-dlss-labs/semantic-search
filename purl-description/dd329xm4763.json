    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This CD-ROM contains digital high-resolution seismic-reflection and bathymetric data collected by the USGS aboard the RV CORLISS during Aug. 25 to Sept. 15, 1998. The study area included the lower part of the Columbia River Estuary, Willapa Bay, and the inner shelf off of Willapa Bay and Grays Harbor, Wa. Three types of seismic data were collected: 3.5-kHz profiles were collected on all lines; sparker profiles were collected on the shelf, in Willapa Bay, and at the mouth of the Columbia River; and boomer profiles were collected farther up the Columbia River Estuary.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
