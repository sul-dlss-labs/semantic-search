        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "b) run the command \"cat [filename].tgz_* | tar xz\" from the terminal",
            "type": "reassembly",
            "identifier": [],
            "displayLabel": "Reassembly of Contents",
            "note": [],
            "appliesTo": []
        },
        {
