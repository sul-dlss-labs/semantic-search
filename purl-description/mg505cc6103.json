    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data accompanies Cardona JL, Dabiri JO (2022) “Wind speed inference from environmental flow-structure interactions, part 2: leveraging unsteady kinematics,” Flow 2: E1. The dataset includes videos of a Magnolia grandiflora moving in response to wind, as well as the corresponding wind speed measurements. The post-processed tree deflection measurements are also available here. Example code is provided to show how the video frames were processed. \r\n",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Cardona JL, Dabiri JO (2022) “Wind speed inference from environmental flow-structure interactions, part 2: leveraging unsteady kinematics,” Flow 2: E1.",
