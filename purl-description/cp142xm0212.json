    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Photographs of public squares (piazze) around Italy in Spring 2020 that are empty of people due to the COVID-19 pandemic. In this context \"the piazza has momentarily lost its social function and has acquired a novel one as a physical open space, rediscovering formerly hidden architectural lines and new perspectives of light\" (Luigi Di Maio, introduction to work). The photographs are joined by short original essays by key Italian authors linked to these places.",
            "identifier": [],
            "displayLabel": "Summary",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "un'iniziativa del Ministero degli Affari Esteri e della Cooperazione Internazionale ; ideazione e cura, Marco Delogu ; scritti di Edoardo Albinati (and 20 others) ; immagini di Olivo Barbieri [and 18 others] = An initiative promoted by theMinistry of Foreign Affairs and International Cooperatio ; conceived and curated by Marco Delogu ; texts by Edoardo Albinati [and 20 others] ; images by Olivo Barbieri [and 18 others]",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
