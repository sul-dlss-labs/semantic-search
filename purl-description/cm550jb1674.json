    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Compressed air and vacuums are very important in the field of dentistry, Compressed air is used to operate tools and vacuum keeps the oral cavity clean. This equipment is very expensive, noisy and bulky and it is hard for dentists in developing countries to purchase these machines. Team DCI has developed INNOVair a compression and vacuum tool that is quiet, affordable and easy to move.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mishra, Tanmay, Quintero, David, Smith, Brandon, Tut, Rajveer Singh, Kitashima, Koji, Kondo, Atsushi and Nishimoto, Satoshi. (2006). INNOVair. Stanford Digital Repository. Available at: http://purl.stanford.edu/cm550jb1674",
