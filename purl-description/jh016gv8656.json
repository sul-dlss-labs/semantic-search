    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The War on Drugs is a fight that has led to non violent drug offenses to be the leading cause of incarcerations. Unfortunately, minorities, mainly African Americans and Latinos, reap the consequences of this, as they represent the majority of these imprisonments. This leads the issue to be of racist nature, because although wealthy caucasians are more prone to the usage of illegal narcotics, minorities not only have a higher incarceration rate, but also serve proportionally longer amounts of time in prison.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
