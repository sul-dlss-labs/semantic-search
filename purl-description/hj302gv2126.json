    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data package contains the model inputs and outputs used in \"Controls on flood managed aquifer recharge through a heterogeneous vadose zone\" (Perzan et al., HESS, 2023). The repository includes all files required to perform stochastic flood-MAR simulations using the integrated hydrologic model ParFlow. We also include selected raw model output (three dimensional pressure, saturation and velocity fields) from the 284 simulations analyzed in the accompanying paper. Finally, we include processed data files of selected metrics from each simulation, along with the python and shell scripts used to create them.\r\n\r\nPlease download and read readme.md before downloading other data, as the cumulative size of this repository is large (>500 GB). ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Perzan, Z., Osterman, G., and Maher, K. (2023). Data-model files associated with the manuscript \"Controls on flood managed aquifer recharge through a heterogeneous vadose zone\" (Perzan et al., HESS, 2023). Stanford Digital Repository. Available at https://purl.stanford.edu/hj302gv2126. https://doi.org/10.25740/hj302gv2126.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
