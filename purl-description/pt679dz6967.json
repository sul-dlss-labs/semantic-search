    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data package contains the model inputs and outputs used in \"Transport, dispersion and degradation of nonpointsource contaminants during flood managed aquifer recharge\" (Perzan and Maher, 2023). The repository includes all files required to perform stochastic flood-MAR simulations using the integrated hydrologic model ParFlow as well as input files for performing Lagrangian particle tracking using EcoSLIM. We also include selected raw model output (3D fields of particle locations over time) from the 342 simulations analyzed in the accompanying paper. Finally, we include processed data of selected metrics from each simulation, along with the python and shell scripts used to create them.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Perzan, Z. and Maher, K. (2024). Data-model files associated with the manuscript \"Transport, dispersion and degradation of nonpointsource contaminants during flood managed aquifer recharge\". Stanford Digital Repository. Available at https://purl.stanford.edu/pt679dz6967. https://doi.org/10.25740/pt679dz6967.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
