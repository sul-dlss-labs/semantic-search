    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains frequency following responses (FFRs) to three CV phonemes (ba, da, di) and music stimuli (piano, bassoon, tuba). FFRs were collected from 13 normal-hearing participants. Each stimulus was 135 msec in length, and each participant experienced 2,500 repetitions (or sweeps) of each stimulus. Stimuli were presented and responses were collected using the Intelligent Hearing Systems (IHS) SmartEP platform. The dataset contains raw IHS .txt export of individual recordings in 100-sweep averages (78 files in .zip archive, 531 MB unzipped); raw 100-sweep averages from individual recordings converted to Matlab (.mat) format (78 files in .zip archive, 114 MB unzipped); aggregated, epoched 100-sweep averages in a single .mat file (1 file, 42 MB); aggregated, epoched 500-sweep averages (computed within-stimulus, within-participant) in a single .mat file (1 file, 8 MB); and perceptual identification responses (13 files in .zip archive, <1 MB unzipped). A .mat file containing time sample labels of the raw recordings is also provided.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Steven Losorelli, Blair Kaneshiro, Gabriella A. Musacchia, Karanvir Singh, Nikolas H. Blevins, and Matthew B. Fitzgerald (2019). Stanford Translational Auditory Research - Frequency-Following Response Dataset 1 (STAR-FFR-01). Stanford Digital Repository. Available at: https://purl.stanford.edu/cp051gh0103",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Steven Losorelli, Blair Kaneshiro, Karanvir Singh, Gabriella A. Musacchia, Nikolas H. Blevins, and Matthew B. Fitzgerald (2019). Decoding Speech and Music Stimuli from the Frequency Following Response. bioRxiv 661066; doi: https://doi.org/10.1101/661066.",
            "type": "citation/reference",
            "identifier": [],
