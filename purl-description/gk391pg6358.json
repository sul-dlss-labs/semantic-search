    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This code package contains a set of R functions for creating MDS and dendrogram visualizations of multi-category confusion matrices. The code includes options for normalizing and symmetrizing the confusion matrix, and for converting the pairwise similarities to distance measures. In addition, the code offers customization options for plotting labels and images, and for plotting series of MDS plots or dendrograms. Along with R functions, this code package includes scripts with step-by-step examples for creating and customizing each type of plot. Total size of the compressed .zip archive is around 400 KB.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hyung-Suk Kim, Blair Kaneshiro, and Anthony M. Norcia (2016). Software Tools in R for Visualizing Proximity Matrices. Stanford Digital Repository. Available at: http://purl.stanford.edu/gk391pg6358",
