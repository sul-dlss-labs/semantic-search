    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This contribution outlines proposed research on conjugate normal faults. Integrating various types of data and analytical tools including 3D seismic data, outcrop mapping, measurement of petrophysical properties, and numerical modeling, I hope to gain insight into the geometries and mechanics of conjugate faults. Other topics that will be addressed include reservoir compartmentalization due to conjugate faulting and variation in syn-depositional units due to conjugate fault growth.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
