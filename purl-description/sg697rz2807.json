    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Project contains all the library design FASTA data, reverse-transcription RTB primers used in library prep, and the output files of Ultraplex-Bowtie2-RNAFramework (UBR) bioinformatics pipeline for the following libraries: Coronavirus 5' proximal stem-loop 5 (SL5) M2seq, Alternative Chemical Mapping, Eternal OpenKnotRound1RFAM-120k, MutationMap, DasBigLib15k-100, Positives240, DasBigLib1M-100, DasBigLib2-1M-130. All the sequencing run FASTQ files are available in National Center for Biotechnology Information BioProject: PRJNA1077399.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Stanford Biochemistry Das Lab, Huang, R., Das, R., Nye, G., Kretsch, R., and Wu, Y. (2024). RibonanzaUBR_output. Stanford Digital Repository. Available at https://purl.stanford.edu/sg697rz2807. https://doi.org/10.25740/sg697rz2807.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
