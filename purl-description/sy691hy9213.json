    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This SOP outlines proper safety procedures for the preparation, handling, and disposal of aqua regia. Aqua regia is a corrosive liquid that is composed of concentrated nitric and hydrochloric acids. It is important to take special care with this procedure. The SOP also specifically outlines the use of this liquid in stir bar cleaning. Certain safety information, notably location of emergency safety equipment, is specific to the Dionne Lab.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dionne, J., Stiber, A., Lay, A., and Solomon, M. (2023). Aqua Regia Standard Operating Procedure and Stir Bar Cleaning Procedure. Stanford Digital Repository. Available at https://purl.stanford.edu/sy691hy9213. https://doi.org/10.25740/sy691hy9213.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
