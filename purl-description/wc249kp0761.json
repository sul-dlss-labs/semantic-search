    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Includes a proposal to Stanford president Donald Kennedy to reassess the ban on buildering (climbing university buildings) on campus, which was received favorably by the president. Background material is included, and a response from Stephen Peeps, Director of University Relations, with the new terms of acceptance for buildering. Also included are two newsclippings, 1959, about the controversy related to Warren Harding's first bolted climb of El Capitan in Yosemite Valley. Ellen Searby, Stanford Alpine Club member and part of the support party for the climbers, was interviewed for the article.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Gift of David H. Coward, 2000.",
            "type": "acquisition",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
