    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Includes primarily manuscript and published scores by various composers, plus a scattering of other material (personal photocopies, composer program notes and addenda, business cards, etc.). Much of the material was sent to the Kronos Quartet by individual composers and publishers to highlight their works and publications. The music is primarily for string quartet with other works for various combinations of voices and/or instruments. Some of the scores have performance markings written in by members of the Quartet. Donations to form and enhance the collection have been received since 1990.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
