    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In areas of complex topography, traditional 2-dimensional mapping techniques may not be sufficient to accurately convey geologic information. We collected 3-dimensional data from Robert’s Rift with a Lieca (Wild) Total Station and have assessed AutoCAD as a tool for 3-dimensional visualization. AutoCAD easily rotates and projects data in 3-dimensions allowing for a clearer understanding of the spatial arrangement of complex geological features.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
