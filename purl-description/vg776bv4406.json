    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis investigates the roles of action and description in the dime novel western. Text mining and machine learning tools show that the dime western uses a significant amount of description - much more than standard critical reception would have you believe - and uses it in surprising ways. Closer investigation of a particular kind of descriptive moment shows just how important description can be, for the novel, the happy ending, and the reader's experience of escape.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
