    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This report presents maps showing ranges of concentrations for selected inorganic chemicals that affect water quality in the region. Water-quality data from 448 wells sampled during 1991-1997 were used to construct five maps showing the regional distribution of total dissolved solids (TDS), arsenic (As), boron (B), fluoride (F), and nitrite plus nitrate as nitrogen (NO2+NO3 as N). For wells sampled more than once, the highest reported concentration for each constituent is shown on water-quality maps. Water-quality data presented are divided into three or four color groups based on concentration. The concentration associated with each color group is indicated in the lower right corner of constituent maps.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
