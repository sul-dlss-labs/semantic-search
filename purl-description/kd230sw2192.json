    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Children start the development of language abilities, encompassing reading and verbal communication skills, from a very young age. Their early language exposure, primarily acquired through parents' accompanied reading and daily conversation, plays a crucial role in shaping their subsequent academic performance in school. Unfortunately, a considerable number of parents lack knowledge and skills about the most effective reading with their children together. Storytails offers AI-generated reading prompts that are customized for each picture book, empowers parents to acquire dialogic reading skills such as turns-taking conversation with lower pressure and creates a more interactive and enjoyable family reading experience. This deposit includes a project report and a project video.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Yang, X. (2023). Storytails: Dialogic Reading EdTech for Parents. Stanford Digital Repository. Available at https://purl.stanford.edu/kd230sw2192. https://doi.org/10.25740/kd230sw2192.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
