    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Accurate water demand forecasting tools must incorporate critical controls on outdoor water use including climate, landscape patterns, socio-economic variables, and policy impacts. However, water agencies currently lack appropriate forecasting tools to understand how irrigation and water use practices may change as urban areas undergo redevelopment and lose urban vegetation to more dense infill development. This project improves our understanding of these lower-level critical controls by characterizing their impacts on outdoor urban water use in the dynamic urban landscape of Denver. These insights promote more accurate demand forecasting at a systems level, which will result in more effective demand management programs. These insights will also help inform urban planning and development for water-efficient cities.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Blount, W. K., Wolfand, J. M., Bell, C. D., Ajami, N., & Hogue, T. S. (2019). U2.15 Blount 2019 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/df254tx8069",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
