    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The MIT-Broad Foundry is a genetic design institute that developed methods for fast and large-scale engineering of genetic systems. The Foundry began as a collaboration between a university and research institute and received support primarily from U.S. government agencies, including the Department of Defense, and industry partners. The Foundry:\r\n• sought to identify and manage risks associated with new technologies beyond those addressed in existing legal, federal, and institutional policies.\r\n• created a culture of responsibility among staff by integrating a self-assessment tool into its routine operations and welcoming researcher participation in expert biosecurity review meetings.\r\n• involved a broad set of stakeholders in biosecurity reviews including law enforcement, intelligence, defense, and policy experts as well as local physical and IT security professionals.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Gordon, B., Casini, A., Salm, M., and Brink, K. (2023). Biorisk Management Case Study: Massachusetts Institute of Technology-Broad Foundry. Stanford Digital Repository. Available at https://purl.stanford.edu/mq491gw2822. https://doi.org/10.25740/mq491gw2822.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
