    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Our group envisioned a \"cloud car\" in which any car can be made truly and instantly personal. Using the driver’s phone data (appointment locations pulled from iCal or transaction histories from e-wallet, for example), the interface translates your personal details into a heat map projected on the windshield. Upcoming destinations of interest would receive a soft color overlay indicating their location. This seamless, non-distracting heat map creates instant personalization and makes distracting, second-screen use obsolete.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
