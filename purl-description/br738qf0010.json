    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We model a multi-agent decision making on the publication of research or innovation as a continuous- time game with simple information and action settings to capture the evolution of the strategy as time progresses. We provide theoretical and numerical analysis on the shift of the system such as by chang- ing the number of agents, and the friction in the publication attempt as well as the social welfare under the competition in the publication game.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
