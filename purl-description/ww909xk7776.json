    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Himalayan caterpillar fungus (Ophiocordyceps sinensis) has become one of the world’s most valuable biological commodities due to its use as an ingredient in traditional medicine.  Here we provide a dataset of caterpillar fungus locations used in the publication \"The demise of caterpillar fungus in the Himalayan region due to climate change and overharvesting.\"  It includes coordinates for 400 caterpillar fungus locations that we compiled from a systematic literature review and supplemented with new GPS records collected in the field.  We used these data to map the current suitable habitat for O. sinensis in order to assess how environmental conditions relate to its production, and how these are affected by climate change.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hopping, Kelly A., Chignell, Stephen M., and Lambin, Eric F. (2018). The demise of caterpillar fungus in the Himalayan region due to climate change and overharvesting: Dataset. Stanford Digital Repository. Available at: https://purl.stanford.edu/ww909xk7776",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
