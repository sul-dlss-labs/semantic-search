            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Amuzie, O. (2022). Chance Me!: Competition Culture in Online College Admission Forums. Stanford Digital Repository. Available at https://purl.stanford.edu/bx966pp0771",
