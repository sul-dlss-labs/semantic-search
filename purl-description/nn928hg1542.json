    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis uses objects to understand Michael Ondaatje's treatment of his characters' identities and ideologies in the 1992 novel The English Patient. An analysis of books and bombs reveals how these objects' physical and representational qualities shape the characters who interact with them, pointing to a relational model of identity.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
