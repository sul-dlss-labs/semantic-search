    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For her capstone project, Kaushikee Nayudu analyzed the practice of political exhumations and explored how this represents a socio-political phenomena embedded in human rights discourses. She researched individual case studies from comparative perspectives and compiled a research presentation as part of the class HISTORY 229C: Political Exhumations: Killing Sites in Comparative Perspective. Her capstone also included creative and multimedia works created using artificial intelligence software as a way of showcasing the existing knowledge about themes related to political exhumations and human rights.\r\n\r\nStudent project deposited by department for archival purposes. Original work unavailable for public download due to permission restriction preferences of the author.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Nayudu, K. (2024). Political Exhumations: Embodied Perspectives in International Law and Aesthetic Inquires with Artificial Intelligence. Stanford Digital Repository. Available at https://purl.stanford.edu/sg876dp5747. https://doi.org/10.25740/sg876dp5747.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
