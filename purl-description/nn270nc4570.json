    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Workshop facilitators often struggle with identifying the appropriate learning goals, creating engaging activities, and sequencing those activities. WorkshopDeck supports facilitators in addressing these challenges by making effective curriculum design, learning sciences, and facilitation techniques easy. WorkshopDeck is a Google Slides Add-on that integrates seamlessly into the facilitator’s design process and delivers just-in-time, research-based, and scaffolded support. Facilitators have access to brainstorming prompts that push their thinking, explanations of learning experience design concepts, and templates that support them in applying what they have just learned. Ultimately, WorkshopDeck lowers the barrier for facilitators to design effective and engaging learning experiences. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Nguyen, C. (2021). WorkshopDeck. Stanford Digital Repository. Available at https://purl.stanford.edu/nn270nc4570",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
