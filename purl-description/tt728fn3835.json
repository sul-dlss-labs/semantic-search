    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This letter from the National Archives, dated May 10, 2022 and written by the acting U.S. archivist, Debra Steidel Wall, to one of Mr. Trump's lawyers, Evan Corcoran, described the state of alarm in the Justice Department as officials began to realize the nature of the documents that the former president held at Mar-a-Lago. It also suggested that top department prosecutors and members of the intelligence community were delayed in conducting a damage assessment about the documents' removal from the White House as Mr. Trump's lawyers tried to argue that some of them might have been protected by executive privilege.  The letter was first disclosed by one of Mr. Trump's allies in the news media, John Solomon, who also serves as one of the former president's representatives to NARA. The archives then released the letter.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"May 10, 2022\"",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
