    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset pertains to the ongoing Jasper Ridge Biological Preserve Ant Survey occurring biannually from 1993 to the present. The dataset contains the number of sites in which a particular ant species was detected during a given year, separated by Fall and Spring surveys. Ant survey methods are described in detail in the accompanying citation.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
