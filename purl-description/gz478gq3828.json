    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Plasmid sequences corresponding to the constructs used in this manuscript. RubyFlag plasmids are either mRuby2 with 3xFLAG tag alone or attached to CENP-N. EF5 plasmids were used to constitutively express SNAP-tagged CENP-A or H3CATD. Ctag_FlagRubyAID is the homology construct for CENP-C AID tagging. hCenp-N is the homology construct for CENP-N AID tagging",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Cao, Shengya, and Zhou, Keda, and Zhang, Zhening, and Luger, Karolin. (2018). Constitutive centromere-associated network contacts confer differential stabilitly on CENP-A nucleosomes in vitro and in the cell. Molecular Biology of the Cell, 29(6): 751-762. https://doi.org/10.1091/mbc.E17-10-0596",
