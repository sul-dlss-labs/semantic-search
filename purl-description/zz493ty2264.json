    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This 3D printed device provides a platform to take photos and videos with a smartphone in the laboratory and out in the field.  It is foldable so that it can be easily transported in a backpack to field locations.  All of the parts are 3D printed so that there are no metal parts and it is waterproof in cold water.  An inexpensive Bluetooth remote shutter is suggested for your iPhone or Android.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rolander, T. (2022). Foldable Vertical Sliding Smartphone Camera Mount. Stanford Digital Repository. Available at https://purl.stanford.edu/zz493ty2264. https://doi.org/10.25740/zz493ty2264.",
