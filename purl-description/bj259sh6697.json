        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hanna House Board of Governors Meeting Minutes (SC1162). Dept. of Special Collections & University Archives, Stanford University Libraries, Stanford, Calif.",
