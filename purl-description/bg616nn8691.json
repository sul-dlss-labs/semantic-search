    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The linked file contains processed reads from Kennewick Man, raw reads were processed as described in the online supplementary information for our paper. In short, reads were trimmed for adapters (if paired end they were also merged), mapped to the human reference genome (hg19) using bwa with default settings and seed disabled. After removing duplicates reads were realigned using GATK, and md fields were filled using samtools calmd.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Morten Rasmussen, Martin Sikora, Anders Albrechtsen, Thorfinn Sand Korneliussen, J. Víctor Moreno-Mayar, G. David Poznik, Christoph P. E. Zollikofer, Marcia S. Ponce de León, Morten E. Allentoft, Ida Moltke, Hákon Jónsson, Cristina Valdiosera, Ripan S. Malhi, Ludovic Orlando, Carlos D. Bustamante, Thomas W. Stafford Jr, David J. Meltzer, Rasmus Nielsen & Eske Willerslev. Supplementary mapped data (.bam) for Kennewick Man. Stanford Digital Repository. Available at: http://purl.stanford.edu/bg616nn8691",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rasmussen, M. et al. \"The ancestry and affiliations of Kennewick Man.\" Nature. Published online June 18, 2015. http://dx.doi.org/10.1038/nature14625",
            "type": "citation/reference",
