    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Social-emotional learning (SEL) is critical for student success. We created PetMe, a tablet game for children ages 6-8, to provide much-needed instructional materials for schools. In this two player game, children take care of a shared pet. They learn how to navigate their different perspectives and empathize with the pet’s problems in an effort to collaboratively reach their shared goal of solving the pet’s needs. Along the way, the players are taught to express their points of view and work toward resolving conflicts.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Xiao, Wendy and Yu, Jongwon. (2017). PetMe: Sharing Digital Pets, Building Real Collaboration Skills. Stanford Digital Repository. Available at: https://purl.stanford.edu/xh211hp3089",
