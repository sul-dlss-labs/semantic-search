    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A CIFE seed project to build a computer system capable of interpreting Process and Instrumentation Drawings (Pe3IDs) was initiated in early October of 1994. A prototype methodology for computer interpretation of Pe3IDs has been developed and implemented on a UNIX platform. The system is presently able to interpret a portion of an actual Pe3ID stored in the DXF format: as well as various small test drawings.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Howie, Cameron T. and Binford, Thomas and Chen, T. and Kunz, John and Law, Kincho. (1995). WP037: Computer Interpretation of Process and Instrumentation Drawings; Progress Report 1. Stanford Digital Repository. Available at: http://purl.stanford.edu/gj223dm2185",
