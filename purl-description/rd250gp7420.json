    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Interactive simulations are powerful tools to help users learn how different phenomena work by encouraging hypothesis generation and testing. However, it can be challenging to learn how to design them from scratch. Educators already know how to create educational materials, but how do they translate that content to an interactive digital interface? CoCurate is a card deck that simplifies the design process into seven easy-to-follow steps, includes dozens of real-world examples, and provides opportunities for self-reflection to support educators in learning what makes an effective simulation.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Summ, H. (2023). CoCurate. Stanford Digital Repository. Available at https://purl.stanford.edu/rd250gp7420. https://doi.org/10.25740/rd250gp7420.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
