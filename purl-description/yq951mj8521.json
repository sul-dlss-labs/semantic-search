    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The final results of this study represent a set of seismic hazard maps and a set of size specific loading estimates for El Salvador. Further implementation of the result of this study in seismic code regulations for a seismic code for lateral loads, will narrow the gap of the actual engineering practices in El Salvador with the ones performed in countries with modern seismic codes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
