    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Stanford Disability and Disability Rights Advocacy Timeline was started as a 2023 summer project by Madison Bunderson and Amari Pierce, sponsored by the Stanford University Archives and the Stanford Historical Society. The timeline provides a record of how the Disability community has existed and evolved across time at Stanford as a continuous group of advocates, administrators, professors, and students. The record is situated within a larger context of how their existence has interacted with broader disability movements, legislation, and history. The authors and sponsors hope the timeline can help people to understand the importance of the Disability community at Stanford, and to advocate for future supports within the University and elsewhere.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Bunderson, M., and Pierce, A. (2023). Stanford Disability and Disability Rights Advocacy Timeline. Stanford Digital Repository. Available at https://purl.stanford.edu/by708bn9254. https://doi.org/10.25740/by708bn9254.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
