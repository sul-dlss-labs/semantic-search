    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Replication repository for Hwang and Ding's (2020) \"Unequal Displacement: Gentrification, Racial Stratification, and Residential Destinations in Philadelphia\" paper. This repository contains all data and code necessary to replicate Table 1 and reproduce Figure 1 and provides additional unrestricted variables used in the paper. All other tables and figures utilize restricted data. Code is also provided to replicate our gentrification measures and disadvantage indices.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hwang, Jackelyn. (2020). Unrestricted data and statistical code for the findings presented in Hwang, J. and L. Ding. 2020. \"Unequal Displacement: Gentrification, Racial Stratification, and Residential Destinations in Philadelphia\". Stanford Digital Repository. Available at: https://purl.stanford.edu/sn305sy2961",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
