    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A set of hyperspectral image data are made available, intended for use in modeling of imaging systems. The set contains images of landscapes and buildings. The file \"montage.jpg\" is a compilation of monochrome images of the scenes. The images have been recorded with a HySpex line-scan imaging spectrometer (https://www.hyspex.com/) covering the spectral ranges 400nm to 950nm.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A collection of hyperspectral images for imaging systems research\r\nT. Skauli and J. Farrell\r\nProc. SPIE 8660, Digital Photography IX, 86600C (February 4, 2013)",
            "type": "preferred citation",
