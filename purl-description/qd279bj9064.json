    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The purpose of this time series is to document small-scale changes in the sessile benthic community within the Hopkins Marine Life Refuge. Data are gathered photographically from permanently-marked vertical or steeply-sloped rock surfaces. Horizontal surfaces were avoided in order to minimize the masking effect of large overlying algae that are more prevalent on horizontal substrates.\r\n\r\nPermanent 0.5 m2 plots are photographed at least 3 times per year: in late winter (canopy-minimum, after winter storm disturbance but prior to onset of spring/summer larval recruitment), mid-summer (canopy maximum, peak growth & expansion of seasonal spp. such as tunicates) & late autumn (declining canopy cover, recession of seasonal spp). Thirty-two locations comprising 52 individual photoquadrats are divided among three sites within the kelp forest adjacent to the marine station.\r\n\r\nThis item contains the photos from WaveGauge through December 2021.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Micheli, Fiorenza. (2011-2021). Marine Life Observatory Photoquadrats - WaveGauge Photos. Stanford Digital Repository. Available at: https://purl.stanford.edu/qd279bj9064",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
