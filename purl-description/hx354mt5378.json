    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Essay on details regarding summer fellowship project for CSRE 100P: Student and Community Organizing for Social Change. During the summer, I interned for Somos Familia, a nonprofit that bridges the gap between queer and Latinx communities by providing resources to the Spanish-speaking population of the east San Francisco Bay Area and abroad. Includes an in-depth analysis of the social change issue, community partnership, and a critical reflection.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ramirez, E. (2022). CSRE 100P Summer Project: Somos Familia. Stanford Digital Repository. Available at https://purl.stanford.edu/hx354mt5378. https://doi.org/10.25740/hx354mt5378.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
