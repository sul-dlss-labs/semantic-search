    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Bird Rock Weather Station, established in 2002, is one of two weather stations at the Hopkins Marine Station. We have records from the Bird Rock station since November 2002. \r\n\r\nRecords are accumulated and averaged every ten minutes 24 hours per day, 7 days per week. Standard deviation, minimum and maximum are also recorded for the ten-minute periods. Parameters include: wind speed and direction, temperature, solar irradiance, and humidity.\r\n\r\nThe Station's coordinates are 36.62136° N and 121.9042° W. \r\n\r\nStation data is archived annually.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
