    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A collection of email newsletters from Stanford Libraries Data Management Services. Newsletters are published approximately monthly and cover a variety of data-related topics relevant for scientific researchers at Stanford University. Regularly-featured content themes include feature stories, data deposit or dataset of the month, tip of the month (best practices), tool spotlights, learn more, and further reading.\r\n\r\nNote that the dates displayed within some of the files at the tops of the newletters are incorrect. Please refer to the dates included in the file names for accurate information about when each newsletter was published.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hodge, Amy E. (2013-2020). Stanford Libraries Data Management Services Monthly Newsletters. Stanford Digital Repository. Available at: https://purl.stanford.edu/hk947yx8059",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
