            "parallelValue": [],
            "groupedValue": [],
            "value": "Ferhani, Y. (2022). How green can blue hydrogen be?. Stanford Digital Repository. Available at https://purl.stanford.edu/gh796dg2407",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
