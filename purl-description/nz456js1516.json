    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "•  Nonpoint source pollution (NPS) is ubiquitous but difficult to treat\r\n•  Biohydrochemical Enhancements for Streamwater Treatment (BEST) is a new\r\npatent-pending technology to treat NPS with engineered hyporheic zones (HZ).\r\n•  BEST vs. Control. At Mines Park Test Bed, BEST had:\r\n1.  50% larger effective HZ\r\n2.  50% faster removal of Resazurin indicator dye (BOD)\r\n3.  20-30% faster reach-scale nitrification and denitrification",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Herzog, S. P., Halpin, B. N., Portmann, A. C., Becker, P., Marlin, F., Brown, D., Higgins, C. P., Eisenstein, W. A., & McCray, J. E. (2017). N3.04 Herzog 2017 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/nz456js1516",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Herzog, S. P., Higgins, C. P., & McCray, J. E. (2016). Engineered Streambeds for Induced Hyporheic Flow: Enhanced Removal of Nutrients, Pathogens, and Metals from Urban Streams. Journal of Environmental Engineering, 142(1). http://doi.org/Artn 0401505310.1061/(Asce)Ee.1943-7870.0001012",
            "type": "citation/reference",
