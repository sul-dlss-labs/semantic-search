    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This work is an autoethnography tracing my educational journey as an English language learner. While there is extensive literature on bilingualism and the best techniques for teaching English in schools, there is not a lot of focus on the emotional and psychological impacts bilingualism has on children. I explored some of my own past experiences and reflected on the impact they had on me as well as shaping the way I grew up. My hopes in writing this is to give light to some of the hardships children face as English language learners both in and out of classrooms. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
