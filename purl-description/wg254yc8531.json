    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Due to its 53 miles of Bayshore and 56 miles of coastline, San Mateo County (SMC) is\r\noften referred to as “ground zero” for sea level rise (SLR) in California. By 2100, it is\r\nestimated that 40% of SMC’s land could be adversely impacted by SLR.1 OneShoreline\r\nwas created to pursue multiple strategies, including working with local jurisdictions\r\nacross San Mateo County to develop and implement policies to protect against SLR.\r\nAs such, the Stanford Fall 2021 Public Policy Practicum team proposes ten\r\napproaches to assist OneShoreline in promoting place-based SLR mitigation\r\nstrategies in the region while providing ongoing support for cities adapting their SLR\r\nresponse strategies for new development on the San Francisco Bayfront.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Arjon, R., Quinn, H., Scekic, S., Stout, A., and Thekkedath, A. (2022). Policy Approaches for Bayfront Resilience in San Mateo County. Stanford Digital Repository. Available at https://purl.stanford.edu/wg254yc8531",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
