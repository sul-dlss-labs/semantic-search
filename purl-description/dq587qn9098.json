    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This report incorporates 1,030 stations obtained from the Defense Mapping Agency for the Fresno 1 by 2 degree sheet as well as reduces previously published data from Robbins and others (1975) report to the IGSN 71 datum and GRS 67 ellipsoid formula.  A comparison of the complete Bouguer anomaly gravity values contained in Robbins and others (1975) report based on the 1963 datum and 1930 ellipsoid formula and those values contained in this report shows a difference of approximately 2.2 mGal.  The addition of the Defense Mapping Agency data greatly enhances regional gravity coverage of the southwestern portion of the quadrangle.  The report also contains isostatic residual gravity values for the 3,152 gravity stations within the Fresno quadrangle.  Part A of the report is a paper copy describing how the study was done and presenting the data in tabular format; part B is a 5-1/4 inch floppy diskette containing only the data files in ASCII format.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
