    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Additional data to the manuscript \"Improved reactor design enables productivity of microbial electrosynthesis on par with classical biotechnology\" that could not be deposited as SI on the journal homepage due to the journal's restriction on supplementary information. The file mainly contains detailed information about reactor assembly and operation, additional methods, and a description and discussion of the full experimental data of the experiments that are shown in the publication.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Deutzmann, J., Spormann, A., and Callander, G. (2024). Additional Data and Methods to \"Improved reactor design enables productivity of microbial electrosynthesis on par with classical biotechnology\". Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/mq042fm9808/version/1. https://doi.org/10.25740/mq042fm9808.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
