            "parallelValue": [],
            "groupedValue": [],
            "value": "Wang, Q., DeWitt, J., Chaudhary, K., Phan, L., Hunter, M., and Ravindar, N. (2023). BIOME: Building Use Analyzer and Dashboard. Stanford Digital Repository. Available at https://purl.stanford.edu/rf245sb6055. https://doi.org/10.25740/rf245sb6055.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
