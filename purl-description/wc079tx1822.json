    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis explores the discourse and narratives about homelessness engaged in by residents of Santa Cruz, California. Through ethnographic interview and participant observation, the author identifies a number of particular narratives and analyzes the way that they impact politics and ethics towards homelessness. This thesis posits that implicit commitment to neoliberal ideology undermines the compassion and structural critique of many individuals in Santa Cruz. A process of rejection, deterritorialization, and pathologization further constructs the homeless as other—destabilizing their political subjecthood and personhood. Working with the story of one particular unhoused man, the author considers the potential for resistance and liberation in houseless life. The author concludes by pointing towards a compassionate politics of homelessness that accepts vulnerability as an essential part of life and does not seek to fabricate impossible invincibility.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hathaway, S. (2024). The Proper Place for Them: Blame, Personhood, and Liberation in Discourses of Homelessness. Stanford Digital Repository. Available at https://purl.stanford.edu/wc079tx1822. https://doi.org/10.25740/wc079tx1822.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
