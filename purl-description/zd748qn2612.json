    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "From October 1931 through June 1933, Hopkins Marine Station (HMS) graduate student Willis G. Hewatt collected observational data along a strip of intertidal rocks 108 yards long and one yard wide. His research included an inventory of invertebrates living along the transect line, environmental conditions, breeding seasonality, and species succession. Hewatt was investigating the nature and causes of the vertical and horizontal zonation of the littoral invertebrates of a rocky shore. This dataset is comprised of data transcribed from the tables in Hewatt's dissertation (19 in total). We also include a complete list of species mentioned in his thesis (\"Part X. Systematic list of species\"), and an un-numbered table with observations of \"breeding records of 52 species,\" which include a date and observation notes. Taxonomic names were transcribed exactly as written - be advised that several names have changed since 1933. These data were transcribed by Melissa Tabbarah and Amanda Whitmire, staff of the Harold A. Miller Library at Hopkins Marine Station.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Whitmire, A. and Tabbrarah, M. (2023). Data from: Ecological studies on selected marine intertidal communities of Monterey Bay. Stanford Digital Repository. Available at https://purl.stanford.edu/zd748qn2612. https://doi.org/10.25740/zd748qn2612.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
