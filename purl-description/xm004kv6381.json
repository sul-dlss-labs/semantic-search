    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The pelagic squid Sthenoteuthis oualaniensis displays full on/off chromatophore flashing and a distinctive chromatophore pattern. A number of these squid were caught and observed in order to further study this behavior. S. oualaniensis tends to flash with a frequency of 5 Hz, but sometimes flashes with an irregular frequency. This variation in behavior appears to be caused by external stimulus, raising the possibility that this flashing behavior is a response to external factors. Because most flashing does not appear to serve a camouflage purpose, it is conjectured that flashing serves as a means of communications or display.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
