    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Denver is facing increasing population growth which is being supported\r\nby infill development – the increasingly popular practice of building new residential units within existing developed urban areas on vacant or under-utilized parcels of land. Ideally, growing cities make well-informed stormwater management decisions that are guided by the knowledge of current and future hydrologic conditions. Unfortunately, because many urban areas, such as Denver, are experiencing new and unknown patterns of rapid redevelopment, this type of knowledge is lacking. This research focuses on high-resolution modeling of the impacts of infill development on stormwater runoff across a Denver neighborhood so as to address the research objectives below.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Panos, C. L., Hogue, T. S., McCray, J. E., & Gilliom, R. L. (2018). U2.05 Panos 2018 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/fx428kp6136",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
