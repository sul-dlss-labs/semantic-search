    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Recognized worldwide as a leader in science, Carl Djerassi's achievements have spanned numerous decades. He has received the National Medal of Science, the National Medal of Technology, the Priestly Medal, and the first Wolf Prize in chemistry. He is the chemical \"Father of the Pill\" and has published 1,200 scientific papers, five novels, five non-fiction books, 11 plays, poetry, essays, and short stories. He has 32 honorary degrees.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
