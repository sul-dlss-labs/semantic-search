    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This standard operating procedure (SOP) provides general guidance on working safely with lab-scale quantities of reproductive toxins. In some cases, multiple SOPs may apply to a single chemical  (e.g., for benzene, both General Use SOPs for flammable liquids and reproductive toxins would apply). For questions about the applicability of any item in this SOP, contact your Principal Investigator/Supervisor or EH&S at 650-723-0448 or EHS_Research_SOP@lists.stanford.edu.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Stanford EH&S (2024). General Use SOP for Reproductive Toxins. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/fb387hf3799/version/1. https://doi.org/10.25740/fb387hf3799.",
