            "parallelValue": [],
            "groupedValue": [],
            "value": "Kornberg, Gil. (2019). The Bell System: A Model of Corporate Innovation and Public Service. Unpublished Honors Thesis. Stanford University, Stanford CA.",
            "type": "preferred citation",
