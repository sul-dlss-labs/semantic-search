    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis explores the potential of Buffalo restoration to lead the Lakota people to a healthful Lakota future. Through background and socio-cultural context, storytelling and the intergenerational life-story analysis of the author and her father, and a discussion of medical anthropology and radical hope, this thesis aims to assert Buffalo restoration as mechanism towards realizing a radical reconceptualization of Lakota public health.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "DuBray, E. (2023). Tatanka Awicagli na Mahpiya Ile Win: An Intergenerational Story of Buffalo Restoration and Lakota Futures. Stanford Digital Repository. Available at https://purl.stanford.edu/zp626px0296. https://doi.org/10.25740/zp626px0296.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
