    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This project, developed in partnership with the NSF SRN Urban Water Innovation Network (UWIN) at Colorado State University, is determining the sustainability of ReNUWIt stormwater and wastewater treatment technologies. Here we compare ReNUWIt technologies relative to traditional technologies by using the UWIN sustainability framework. Research objectives include jointly developing the framework, gaining sufficient information on cost, maintenance, hydrologic and environmental performance of ReNUWIt technologies at the field scale to analyze using this framework.\r\nThe resulting system-scale sustainability analysis should assist in encouraging ReNUWIt technology dissemination to industry, as well as provide information to ReNUWIt researchers on activities necessary to conduct a system-wide sustainability analysis.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mills, K., Sharvelle, S., Al'Jafari, J., Stokes-Draut, J. R., Grubert, E., & McCray, J. E. (2019). U2.13 Mills 2019 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/gw149dx2437",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
