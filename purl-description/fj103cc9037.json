    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The structure of Japan's electricity sector, as modified by legislation in 1995 and 1999, will be reviewed in 2003. At that time, it is likely that further decisions will be made regarding the restructuring of Japan's electricity sector. The objectives of this study are to provide insight into the alternative ways that the sector might be restructured and the experience of other countries that have already undertaken restructuring. It is hoped that learning from the experiences of others can help Japan find its own best way to provide low-cost, reliable and environmentally acceptable electricity to all its end-users.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Bjornsson, Hans and Crow, Robert and Huntington, Hillard. (2004). TR150: International Comparisons of Electricity Restructuring: Considerations for Japan. Stanford Digital Repository. Available at: http://purl.stanford.edu/fj103cc9037",
