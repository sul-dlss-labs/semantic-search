    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Robben Island is an island in Table Bay located near South Africa. It is regarded as a World Heritage Site by the United Nations Educational, Scientific and Cultural Organization (UNESCO). The focus of the island has been on its role as a maximum-security prison during apartheid and the famous prisoners within it, such as Nelson Mandela. While it is important to acknowledge the impact of the political prison, Robben Island has a rich and important history outside of the apartheid. As a result, we found that there was a need to create a new resource to bring other aspects of the island to life. Focusing on creating a resource for high-school students, we created a virtual field trip to Robben Island to help students understand the histories beyond Nelson Mandela.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Nguyen, K. (2023). Robben Island Heritage Project. Stanford Digital Repository. Available at https://purl.stanford.edu/qq222qm6006. https://doi.org/10.25740/qq222qm6006.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
