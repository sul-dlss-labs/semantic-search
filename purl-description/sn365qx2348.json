    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Existing interpretations of the structure beneath Sheep Mountain Anticline conflict with one another. We plan to reprocess ten 1980s vintage 2D seismic reflection profiles in the hopes of imaging the fault geometry beneath the anticline, focusing specifically on the abutting relationship between two oppositely dipping thrust faults. The timing relationship between these two faults has important implications for the mechanism of formation of the youngest fracture set on the backlimb of the anticline.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Fiore, Patricia E. and Bellahsen, Nicolas. (2005). Reinvestigation of the Fault Geometry Beneath Sheep Mt. Anticline, Wyoming: Implication for Fracture Patterns. Stanford Digital Repository. Available at: http://purl.stanford.edu/sn365qx2348",
            "type": "preferred citation",
