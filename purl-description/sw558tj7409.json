    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Several countries around the world face challenges with rising high school dropout rates. Just in Brazil, only 56% of high schoolers graduate at the age of 19. One of the root causes behind this striking figure is students' shared perception that school lacks relevance to their lives. Research shows that students engage deeper with school when they see a purpose in their education. LEAP is a mentoring curriculum powered by technology that guides high schoolers to find meaning in their school experiences. By reflecting on their passions, interests and life goals with an inspiring mentor, students will be able to better understand the connection between what they learn in school and what they want to accomplish in their future.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
