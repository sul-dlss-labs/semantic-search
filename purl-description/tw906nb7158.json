    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Collection of short biographies of French people of note who \"chose\" or \"gave service\" to France, aiming to highlight the diversity of the French population. This work was created under the direction of the Agence nationale de la cohésion des territoires, initially to serve local authorities in naming streets and public buildings, in recognition that the place names of early 21st century France did not reflect the diversity or experiences of the current population.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
