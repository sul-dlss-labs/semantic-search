    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The two-phase flow problem at hand consists of a pipe network in three dimensions. Given the pressure at the inlet node and the amount of liquid and gas flow rates in the inlet pipe, the problem requires the determination of the pressure value at the other nodes. The total pressure drops along the common pipe legs should be equal. Beggs and Brill's method is used for computing the pressure drops.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
