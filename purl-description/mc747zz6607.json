    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data set includes a zip file for each subject containing 1) an unprocessed OralEye camera image of the subject's tongue (file.raw), 2) a processed OralEye camera image (file.jpeg),  and 3) a json file (file.json) that contains information about the camera exposure duration, camera gain, image size, type of light, date and time of image capture.   The data set also contains a zip file containing data that was used to calculate simulated camera image data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Simulations of fluorescence imaging in the oral cavity\r\nZ.  Lyu, H. Jiang, F. Xiao, J. Rong, T. Zhang, B. Wandell,  J. Farrell\r\nin bioRxiv 2021.03.31.437770; doi: https://doi.org/10.1101/2021.03.31.437770",
