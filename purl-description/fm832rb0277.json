    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This senior thesis discusses women’s role in the 1936-37 Flint sit-down strike, long seen as one of the pivotal events in bringing unionization to the nation’s automotive industry. It argues that women’s experiences during the strike and contributions to its success resulted in fundamental structural change in the United Auto Workers (UAW) union in subsequent years. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Spaeth, E. (2022). Days Gone Forever: Women’s Role in the 1936-37 Flint Sit-Down Strike and its Influence on the United Auto Workers Union. Stanford Digital Repository. Available at https://purl.stanford.edu/fm832rb0277",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
