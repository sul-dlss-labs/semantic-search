    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Mapping Interstate Territorial Conflict (MITC) project consists of precise digital maps of regions that were the subject of interstate territorial disputes in the period 1947-2000.  Disputes identified by Huth and Allee (2002) were rendered as polygons corresponding the regions of states' overlapping claims.  Further information can be found in the codebook and the published paper describing these data, referenced below.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kenneth A. Schultz. (2019). Mapping Interstate Territorial Conflict. Stanford Digital Repository. Available at: http://purl.stanford.edu/zc000fq4044",
