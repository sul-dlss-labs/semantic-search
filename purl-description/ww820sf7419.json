    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This book, published only online, explores further the entanglements between humans and things. It contains theoretical and methodological developments including a redefinition of human-thing entanglement and the application of formal network analysis. The book also contains a series of case-studies regarding the formation of settled life in the Middle East, the adoption of agriculture, and the study of power and poverty, creativity and religion. The book ends with a critical dialogue regarding the issues raised by studies of entanglement.\"--Ian Hodder home page.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ian Hodder.",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
