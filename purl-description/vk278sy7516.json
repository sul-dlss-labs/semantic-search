    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Repo contains input data for the modelling in the paper Development and Application of a 1D Compaction Model to Understand 65 Years of Subsidence in the San Joaquin Valley, as well as the 10080 simulations used for that paper. This repo contains the well completion reports, head data and resistivity log data used in the study. The head data are in the repository but are 'hidden' because they are not publicly available. Please contact mlees@stanford.edu if you need to see these data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Lees, M. (2022). Data repository for Development and Application of a 1D Compaction Model to Understand 65 Years of Subsidence in the San Joaquin Valley. Stanford Digital Repository. Available at https://purl.stanford.edu/vk278sy7516",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
