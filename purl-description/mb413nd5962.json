    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "GenieKey and GenieCoach, help the driver on-the-go, who has a million things to keep track of and makes many trips, with many stops, and many different passengers, every day.  Are you a student, whose life revolves around driving to and from your sports, club meetings, library, social events, and maybe even the occasional road trip?  Are you a parent, balancing work with your children’s needs, activities, and your own social calendar?  Do you never have quite enough time to get everything done, but does everything need to run like clockwork?",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
