    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Our vision is SHIFT, a system of small, voice-activated robots that sit beneath pieces of furniture in the home and move to reposition them at the user’s command. With simple pods that can be securely placed in seconds, SHIFT allows the user to turn any existing piece of furniture into an autonomously moving smart-device, capable of acting independently or in coordination with the furniture around it",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
