    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In this study, I explore these intertwined concepts of habitat fragmentation and Island Biogeography through observations in the rocky intertidal zone. Using the rocky intertidal zone as a proxy for large-scale protected areas, I investigate any potential relationships between species richness, pool size, and overall connectivity between disjointed pool habitats.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Vogel, J. (2022). Island Biogeography Theory and Protected Area Development: An Intertidal Zone Analysis. Stanford Digital Repository. Final report for BIOHOPK47. Available at https://purl.stanford.edu/jw652wh0508",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
