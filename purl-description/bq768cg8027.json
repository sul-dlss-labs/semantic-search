    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Felicia Smith was featured as the speaker at a Fireside Chat at the Black Community Services Center to celebrate Black History Month. This event was hosted by Stanford's Black Panther Party Reading Group and included discussions about Felicia's event as part of Stanford Libraries' Justice, Equity, Diversity and Inclusion (JEDI) Fair in October 2022, that was a book signing event with three women of the Black Panther Party Ericka Huggins, Rosita Thomas and M. Gayle Asali Dickson. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "SMITH, F. (2023). Women of the Black Panther Party: The Struggle is Real. Stanford Digital Repository. Available at https://purl.stanford.edu/bq768cg8027. https://doi.org/10.25740/bq768cg8027.",
            "type": "preferred citation",
