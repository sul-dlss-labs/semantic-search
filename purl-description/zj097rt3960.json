    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The decision to migrate is a complex interplay of numerous factors, including quality of life considerations, job opportunities, cultural ties, and linguistic preferences. This paper presents a case study of Quebec, a province in Canada distinguished by its emphasis on the preservation of the French language, the prioritization of French-speaking immigrants, and the recent election of a nationalist party, the Coalition Avenir Québec (referred to as the CAQ). This paper aims to contribute to the existing literature by examining linguistic, mobility, and economic differences between Quebec and the rest of Canada, as well as the differences between the census divisions that elected the CAQ by a majority and those that did not. The key findings indicate that areas with higher French proficiency are less likely to lose migrants to other parts of Quebec or other provinces and that there was a significant increase in outward mobility after the CAQ came into power.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Taylor, I. (2024). Language Politics and Migration Dynamics: A Case Study of Quebec's French Nationalism and its Impact on Migration Patterns. Stanford Digital Repository. Available at https://purl.stanford.edu/zj097rt3960. https://doi.org/10.25740/zj097rt3960.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
