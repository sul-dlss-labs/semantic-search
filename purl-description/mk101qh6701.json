    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This interactive case about two POLS students' experiences in their field project in Oakland Unified School District. Slides are meant primarily for teaching purposes and can be edited to teach the following objectives to a graduate level education course:\r\n\r\nStudents will be able to…\r\n1. Understand how POLS students’ positionalities can impact their work in their field project\r\n2. Explore the dynamics and complexities of district operations, school board politics, and school closures\r\n3. Reflect on how their own positionalities may impact their upcoming experiences in their field projects\r\n",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Bess, N. and Fuenzalida, C. (2022). Interactive Case: Positionality in Field Work. Stanford Digital Repository. Available at https://purl.stanford.edu/mk101qh6701",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
