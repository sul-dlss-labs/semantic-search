    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Experimental data and code associated with the manuscript titled \"Quantification of the Impact of Acidified Brine on Fracture-Matrix Transport in a Naturally Fractured Shale Using in Situ Imaging and Modeling\".  This repository consists of all the Python codes and dataset used to reproduce the experimental and modelling results presented in the manuscript. A 'Readme.txt' file is provided to describe the dataset and code included in this repository.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zahasky, C., Murugesu, M., Kurotori, T., Sutton, C., Druhan, J., Vega, B., Benson, S., and Kovscek, A. (2024). Solute transport maps in a naturally fractured shale rock before and after acidified brine injection - 4D imaging dataset and analytical model. Stanford Digital Repository. Available at https://purl.stanford.edu/pv902jr5822. https://doi.org/10.25740/pv902jr5822.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
