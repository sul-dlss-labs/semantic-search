            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Xu, X. S., He, Q., Ma, G. Y., Wang, H. Y., Nirmalakhandan, N., & Xu, P. (2018). Selective separation of mono- and di-valent cations in electrodialysis during brackish water desalination: Bench and pilot-scale studies. Desalination, 428, 146-160. http://doi.org/10.1016/j.desal.2017.11.015",
            "type": "citation/reference",
