    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The objective of this research project was to document the current process of design, detailing, fabrication, and erection of structural steel on an actual construction project. The goal was to identify the limitations of this process and identify specific problems created due to lack of standards in sharing of information between project participants, and to demonstrate how CIMSteel Integration Standards will play a role in this process in the future.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
