    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We are presently investigating subsurface fracture distribution in a sandy limestone unit of the Sycamore Formation in the Ardmore Basin of southern Oklahoma. The approach utilizes the following: seismic data to define structure contour maps of the Sycamore, a curvature analysis method for multilayered media, and well data to constrain the model results. The preliminary results obtained thus far are encouraging, but are yet to be valided by actual field data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
