    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Code and Data needed to replicate results in \"Neural Network Vehicle Models for High-Performance Automated Driving\".\r\n\r\nModel_Learning/ contains experimental data on a high friction surface, code to generate data from a vehicle model, code to train models to fit data, and saved models.\r\n\r\nHuman_vs_Machine/ contains data comparing the lanekeeping controller to skilled human drivers.\r\n\r\nControl/ contains code to simulate the controller described in the paper, code to run this controller in real time on a vehicle, and experimental data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Spielberg, Nathan and Brown, Matthew and Kapania, Nitin and Kegelman, John and Gerdes, J. Christian. (2019). Neural Network Vehicle Models for High-Performance Automated Driving: Data and Materials. Stanford Digital Repository. Available at: https://purl.stanford.edu/zb950hd3384",
            "type": "preferred citation",
            "identifier": [],
