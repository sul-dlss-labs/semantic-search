    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis investigates the historical development of the American Muslim community in Detroit from the 1910s to the 1980s. The objective is to understand how different waves of migration influenced the consolidation of Muslim identity in this urban setting. Using a historical analysis method, the research examines three key periods: the arrival of early Arab American migrants who integrated into the Ford Motor Company workforce, the rise of the Nation of Islam among Black American Muslims, and the settlement of educated South Asian Muslims post-1965. The results highlight the complex interplay between economic incentives, racial and ethnic diversity, and religious identity. The conclusion reveals that these dynamics not only shaped the Muslim community in Detroit but also reflect broader themes of migration, assimilation, and cultural persistence in American history.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zahurullah, Y. (2024). Gears of Migration: Internal American Muslim Dynamics in Detroit, 1910s - 1980s. Stanford Digital Repository. Available at https://purl.stanford.edu/yq442fh7161. https://doi.org/10.25740/yq442fh7161.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
