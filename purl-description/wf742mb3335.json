    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This capstone examines how the local organization of the resistance movement against La Parota Dam has influenced local dam development discourses in Guerrero and neighboring communities and in the media. This paper also analyzes the Mexican government’s violent repression of community resistance to La Parota Dam in order to understand how these narratives of development and violence are shaped and challenged by the La Parota Dam resistance movement.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "De La Cruz, A. (2024). Resisting La Parota Dam: Disrupting Development Discourses in Guerrero, Mexico. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/wf742mb3335/version/1. https://doi.org/10.25740/wf742mb3335.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
