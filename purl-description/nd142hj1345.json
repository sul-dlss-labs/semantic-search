    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ava Mendoza worked as an ethnographer and interviewer on Professor Clair’s Systems Navigator Project with the Santa Clara County Office of the Public Defender. The team of researchers and system navigators observed the courtroom and worked to improve communication and collaboration between lawyers and their clients. They met with and supported defendants, as well as, gathered information on their perception of and experiences with the public defenders. This poster describes her work and some of the findings.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
