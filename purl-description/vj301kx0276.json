    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This airborne electromagnetic (AEM) dataset was acquired in the Kings River alluvial fan to assess the potential use of the AEM method to locate an incised valley fill (IVF) deposit. Densely-spaced lines of data were acquired over an area where surface mapping and drilling had identified the presence of an IVF deposit. The data were acquired using the SkyTEM system. Made available here are the data processed by Aqua Geo Frameworks, Ltd.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Knight, R., Steklova, K., Miltenberger, A., Kang, S., Goebel, M., and Fogg, G. (2022). Airborne Electromagnetic Data Acquired Over Incised Valley Fill Deposit in California's Central Valley. Stanford Digital Repository. Available at https://purl.stanford.edu/vj301kx0276. https://doi.org/10.25740/vj301kx0276.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
