    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Our goal is to reduce every driver's stress. The EZ park is designed to help every driver in their search for finding parking spaces at concerts, events, sporting events, or in any parking structure (especially in finding a spot near elevators or stairs). In addition, sensors provided on the driver's steering wheel will sync with the EZ park interface to further aid a driver's pursuit of a safe, stress-reduced driving experience.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
