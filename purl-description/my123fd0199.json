    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We present a new 3-D geomechanical computer program that has been developed to model geological structures with the purpose of satisfying the needs of geologists, geophysicists, and reservoir engineers. The principle of the method is described, and example applications are shown to illustrate the potential of the method, including 2-D unfolding, cross section restoration and 3-D surface unfolding and unfaulting.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
