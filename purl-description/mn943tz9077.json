    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "To help health care organizations and physicians weigh AI-related liability risk against the benefits of adoption, we examine the issues that courts have grappled with in cases involving software error and what makes them so challenging. Because the signals emerging from case law remain somewhat faint, we conducted further analysis of the aspects of AI tools that elevate or\r\nmitigate legal risk. Drawing on both analyses, we provide risk-management recommendations, focusing on the uses of AI in direct patient care with a “human in the loop,” since the use of fully autonomous systems raises additional issues.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mello MM, Guha N. Understanding liability risk from using healthcare artificial intelligence tools. N Engl J Med 2024;390(3):271-278.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
