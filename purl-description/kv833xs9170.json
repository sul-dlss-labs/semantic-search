    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In this episode of Sounds of Stanford, we explore the theme of attraction through stories about attraction to Stanford, to the outdoors and to service. Though Stanford is a widely sought after institution, some disagree over the true gains of an elite education. Delving deeper into the Stanford experience, we will also examine experiences outside traditional classes in the Outdoor Education program. And even within the outdoor community, Stanford Outdoor Outreach Program (SOOP), a Stanford service club which takes East Palo Alto high schoolers on nature trips, offers more insight into the allure of the outdoors and service.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Maddick, Brandon and Tseng, Sharon and Herrera, Logan. (). Sounds of Stanford Episode 18: Attraction. Stanford Digital Repository. Available at: http://purl.stanford.edu/kv833xs9170",
