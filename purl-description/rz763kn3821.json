    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains cortical (EEG) collected while participants heard excerpts of natural music or rhythms; as well as behavioral ratings of the stimuli. Dense-array (EGI 128-channel) EEG was collected while 5 adult participants individually completed multiple listens to a set of 16 30-second musical excerpts. After each listen, the participant rated enjoyment, perceived rhythmic complexity, and ease of finding the beat of the preceding excerpt. Across all participants, 15 recordings were taken, comprising a total of 30 trials collected per stimulus. Data are published in Matlab format. Individual files range in size from 616-701 MB. Total size of the deposit is around 10 GB.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
