    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "An honors thesis focused on analyzing racialization practices rooted in markers of hair and skin tone in Latinx literature. Rooted in the history of colonialism and the crystallization of race, this thesis looks at pratices of colorism, gender dyanmics, and hair politics. This piece looks at the work of Mexican-American authors Cherríe Moraga, Gloria Anzaldúa, and Estella González as well as Dominican author Junot Díaz.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "García, B. (2024). Rhetorics of Hair and Skin Tone: Racialization and Identity Formation in Mexican American and Dominican Diasporic Literature. Stanford Digital Repository. Available at https://purl.stanford.edu/yv537pg3867. https://doi.org/10.25740/yv537pg3867.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
