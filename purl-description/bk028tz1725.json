    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "These files allow for the reproducibility of the analysis in the manuscript \"Submesoscale coupling of krill and whales revealed by aggregative Lagrangian coherent structures\".\r\nrawData.zip includes files and folders that comprise the raw data used in the manuscript\r\nModels.zip contains the Generalized Linear Mixed Effects Models produced in the analysis of the manuscript",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Point Blue Conservation Science, Jahncke, J., and Fahlbusch, J. (2023). Krill and Lagrangian Features data archive. Stanford Digital Repository. Available at https://purl.stanford.edu/bk028tz1725. https://doi.org/10.25740/bk028tz1725.",
