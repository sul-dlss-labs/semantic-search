    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This archive contains the data and Python code generating figures for the article \"Emergent ferromagnetism near three-quarters filling in twisted bilayer graphene\" by Aaron L. Sharpe, Eli J. Fox, Arthur W. Barnard, Joe Finney, Kenji Watanabe, Takashi Taniguchi, M. A. Kastner, and David Goldhaber-Gordon and available at https://arxiv.org/abs/1901.03520. This archive contains the following: 1) TBG_ferromagnetism_figures.ipynb, a Jupyter notebook loading data and generating figures. The notebook has been tested with Python version 3.6.7 and Jupyter notebook server version 5.5.0. 2) HTML_notebook directory that contains 'TBG_ferromagnetism_figures.html' an HTML file generated from the Jupyter notebook, and PNG files loaded by the HTML file, 3) scripts directory that contains additional files used by the Jupyter notebook, and 4) data directory, containing all data used to generate figures for the manuscript, stored as JSON objects. Refer to the notebook for figure captions describing the data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sharpe, A., Fox, E., Barnard, A., Finney, J., Watanabe, K., Taniguchi, T., Kastner, M., and Goldhaber-Gordon, D. (2022). Data for: Emergent ferromagnetism near three-quarters filling in twisted bilayer graphene. Stanford Digital Repository. Available at https://purl.stanford.edu/bg095cp1548. https://doi.org/10.25740/bg095cp1548.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
