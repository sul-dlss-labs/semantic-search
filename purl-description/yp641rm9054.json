    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Team Aperture has developed a product to help construction workers communicate in a more effective manner with their superintendents. Superintendents are often working in a trailer or traveling so construction process can slow down when workers have a question to ask or an issue to resolve. The Lynx System links construction worker’s mobile phones with their superintendent’s laptops so that a two way video conference can easily be achieved. The Lynx System also incorporates a Building Information Modeling system along with a camera so the superintendent can get a complete picture of the work in progress without having to be at the construction site.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Chen, Tianxiang; Mok, Brian; Stromberg, Michael; Carsten, Meyer; Mueller, Stefanie; Taschik, Daniel and Wagner, Bjoern. (2012). The Lynx System. Stanford Digital Repository. Available at: http://purl.stanford.edu/yp641rm9054",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        }
