    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The CyberTipline is the main line of defense for children who are exploited on the internet. It leads to the rescue of children and the arrest of abusers. Yet after 26 years many believe the entire system is not living up to its potential. A new Stanford Internet Observatory report examines issues in the reporting system and what the technology industry, the nonprofit that runs the tipline, and the U.S. Congress must do to fix it.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Grossman, S., Pfefferkorn, R., Thiel, D., Shah, S., DiResta, R., Perrino, J., Cryst, E., Stamos, A., and Hancock, J. (2024). The Strengths and Weaknesses of the Online Child Safety Ecosystem. Stanford Digital Repository. Available at https://purl.stanford.edu/pr592kc5483. https://doi.org/10.25740/pr592kc5483.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
