            "parallelValue": [],
            "groupedValue": [],
            "value": "Susannah Blake Goodman, Tim Little, The Rose Foundation for Communities and the Environment, Environmental Fiduciary Project.",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
