    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This report tracked ten years of governmental, business and nonprofit studies that document significant under-reporting by SEC registrants of financially material corporate environmental liabilities. It examines attempts by oversight agencies, advisory bodies and Congress to close gaps in GAAP, and concludes with a set of recommendations for the SEC. It is part of Environmental Fiduciary Report Series.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
