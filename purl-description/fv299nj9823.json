    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The evolution of faults in sandstones with the associated distribution of cracks is studied by a damage mechanics model. The simulation is motivated by field observations that suggest how fault zones evolve from fracture arrays. We show how the damage mechanics model mimics the evolution inferred from the field with the systematic dependence of the fault style on the initial geometry. This geometry is characterized by the orientations of the stress field relatively to the initial cracks and their arrays. This work is a first step toward a more complete model that will include representative flow properties of damaged rock generated during deformation.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
