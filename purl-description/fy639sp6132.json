    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The essay uses a set of theoretical ideas offered by Susan Leigh Star to argue for a shift in contemporary understandings of, and approaches to, video preservation. Instead of focusing on the granular characteristics of tape and their material stability, I argue, the audiovisual archival community should view preservation as a set of linked systems that function within a web of shifting perspectives and context-driven solutions. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sorensen, Lauren. 2018. “Analog Video in Moving Image Archives & Conservation: Infrastructures of Knowledge from Production to Preservation”. KULA: Knowledge Creation, Dissemination, and Preservation Studies 2 (1):8. https://doi.org/10.5334/kula.32.",
            "type": "preferred citation",
