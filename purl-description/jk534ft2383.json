    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This collection of tables contains the full force displacement data collected for knit samples of varying stiffness. Fabrics A, B, and C are 'soft', and fabrics E, F, and G are 'stiff'. Each tables corresponds to one fabric, and contains data for 5 samples for testing in both the x-direction (wale) and the y-direction (course).",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "du Pasquier, C., Tessmer, L., Chen, T., Tibbits, S., and Okamura, A. (2024). Data for publication: Haptiknit: Distributed Stiffness Knitting for Wearable Haptics. Stanford Digital Repository. Available at https://purl.stanford.edu/jk534ft2383. https://doi.org/10.25740/jk534ft2383.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
