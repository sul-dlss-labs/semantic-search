    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This collection contains police stop and population data for Chicago, Nashville, New York City and Philadelphia. This data was collected to analyze racial disparities in policing for the above jurisdictions and comes from a range of sources (publicly available, census data, by request). All record-level data do not include personal information to preserve privacy.\r\nThe data is structured to reproduce the analyses in \"Identifying and Measuring Excessive and Discriminatory Policing\", \"Empirical Approaches to Identify Systemic Discrimination in Policing\", and \"Precinct or Prejudice? Understanding Racial Disparities in New York City's Stop-and-Frisk Policy\". Our analysis code and further documentation are available at the GitHub repositories below. Clean files are available in .rds and .rdata formats while raw data is available in .csv, .rds, and shapefile formats.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Chohlas-Wood, A., Gerchick, M., Goel, S., Huq, A., Shoemaker, A., Shroff, R., and Yao, K. (2021). Identifying and Measuring Excessive and Discriminatory Policing. Stanford Digital Repository. Available at https://purl.stanford.edu/wb705qc9592",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
