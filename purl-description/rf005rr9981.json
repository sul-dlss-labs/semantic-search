    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Oftentimes, art lovers want to discover new insights in museums, but the advanced information is available away from the art. Project Fay rethinks the learning experience in museums for art lovers. Guided by Fay, a virtual stick figure in mobile app, museum visitors are invited to create their own interpretation of the objects they see by following list of prompts before reading the advanced information offered by museums. In this way, visitors are able to discover new perspectives and understand not only works of art presented in the museum space but also others of the same style.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
