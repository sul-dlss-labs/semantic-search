    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Since October 2022, I supported Professor Subini Ancy Annamma and the Walkout! Lab for Youth Justice team on the project, “Searching for Solutions: Centering the Voices of African American Youth to Address Disproportionate Representation in Special Education and Suspensions in San Francisco Unified School District (SFUSD).” This study’s aim is to build tools for educators to enact their racial justice commitments through reflections on pedagogy and policy from students. Specifically, the project explores trajectories of and strategies identified by Black students that focus on recognizing and reducing exclusionary discipline and instruction. Additionally, by centering their voices, this study seeks to create affirming spaces for Black students in SFUSD.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Low, P. (2023). Critical Connections: Reflections on K–12 School District Change through Research-Practice Partnerships. Stanford Digital Repository. Available at https://purl.stanford.edu/xp266bh6905. https://doi.org/10.25740/xp266bh6905.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
