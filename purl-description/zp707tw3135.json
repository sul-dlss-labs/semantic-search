    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We recorded the EEG brain response of 32 consonant-vowel format syllables. In a recording session, all the sound stimuli were pseudo-randomly presented to one of the four participant subject using stereo speakers. The participants were instructed to listen to the sound attentively while looking at a focus point on the computer screen. Their EEG brain waves were recoded using EGI’s Geodesic EEG System (GES) 300 platform with 128 sensors. The whole data set includes approximately 672 EEG recordings (trials) for each syllable. The total number of trials from one participant ranges from 3584 to 7168.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rui Wang, Marcos Perreau-Guimaraes, Duc Nguyen and Patrick Suppes, \"SBL_Syllable2008 EEG data\". Stanford Digital Repository. Available at: http://purl.stanford.edu/zp707tw3135",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rui Wang, Marcos Perreau-Guimaraes, Claudio Carvalhaes and Patrick Suppes, “Using phase to recognize English phonemes and their distinctive features in the brain”, Proceedings of the National Academy of Sciences, 109(50), pp. 20685-20690. http://dx.doi.org/10.1073/pnas.1217500109",
            "type": "citation/reference",
