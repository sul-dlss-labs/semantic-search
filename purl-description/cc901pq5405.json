    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For her capstone project, Emily Blackwell worked with four other Stanford students to produce a research report for the Accountability Council in San Francisco on independent accountability mechanisms (IAMs) within multilateral development banks. The report offers valuable insights into the outcomes of complaints that fall outside the formal IAM complaint process. The primary objective of this project was to identify areas for improvement within IAMs to enhance commitment implementation, address community needs, and maintain transparent and equitable accountability procedures for non-traditional complaint resolutions. This work contributes to strengthening accountability frameworks and promoting a more inclusive and just society by offering actionable recommendations based on rigorous research and analysis.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Blackwell, E., Ersoz, I., Sharp Queener, S., Walley, A., and Raso, S. (2023). The Unspoken Rules of Multilateral Development Banks Accountability; An analysis of complaints held outside process . Stanford Digital Repository. Available at https://purl.stanford.edu/cc901pq5405. https://doi.org/10.25740/cc901pq5405.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
