    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dataset used for the publication of \"Companies' Contributions to Sustainability through Global Supply Chains.\" We develop a novel, global survey of 449 publicly listed companies in the food, textile and wood-products sectors with annual reports in English to provide insight into how the private sector contributes to advancing the United Nations' Sustainable Development Goals via their sustainable sourcing practices.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
