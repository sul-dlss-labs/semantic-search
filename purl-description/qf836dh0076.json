            "parallelValue": [],
            "groupedValue": [],
            "value": "Petrov, S. (2021). Seismic Images Segmentation with Deep Learning. Stanford Digital Repository. Available at https://purl.stanford.edu/qf836dh0076",
            "type": "preferred citation",
            "identifier": [],
