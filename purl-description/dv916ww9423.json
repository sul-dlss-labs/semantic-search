    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Changing Cities Research Lab (CCRL), led by Stanford Assistant Professor of Sociology, Dr. Jackelyn Hwang, is committed to using quantitative and qualitative methods to inform policy solutions that advance equity in the face of urban change. As a Research Assistant at CCRL, we contributed to projects focused on gentrification and residential instability in Oakland. We assessed the Keep People Housed (KPH) program – a homelessness prevention pilot program administered by Bay Area Community Services (BACS) in partnership with the City of Oakland – by conducting interviews with KPH applicants, encouraging applicants to complete online surveys, and assessing survey data. This data assessment included coding interview data to prepare deliverables for policymakers and the public. On a larger scale, CCRL's assessment of KPH will help inform future homelessness prevention efforts in the Bay Area and beyond. We also performed survey outreach and analyzed two waves of survey data related to Race and Residential Instability in Oakland, a longitudinal project that aims to understand racial disparities in residential instability among low-income residents in Oakland. The Race and Residential Instability project has largely informed the design of KPH and has the similar goals of delivering data-informed policy situations that promote equity.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Pena, G. and Abraham, J. (2024). Gentrification and Residential Instability in Oakland. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/dv916ww9423/version/1. https://doi.org/10.25740/dv916ww9423.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
