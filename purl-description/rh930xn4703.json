    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This study documents and analyzes the distribution and sequence of pressure solution surfaces, joints,folds and various modes of small scale faults around the Las Vegas shear zone and the Bitter Spring Valley fault in order to determine paleostress states in the SE Basin and Range in the late-Tertiary. The observed structural patterns and the stress inversion analyses of fault-slip data suggest that there exist at least five stages of deformation and corresponding paleostress fields.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
