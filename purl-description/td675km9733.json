    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Volvo 310x is a groundbreaking solution for concrete removal in confined spaces.  The remote controlled concrete planing vehicle removes jackhammer operators from hazardous and tedious working conditions.  This facilitates efficient use of human resources and effective recovery of raw materials in urban deconstruction.  This project was completed for Volvo Construction Equipment in the ME310 course.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Brody, Jack; Martin, Tim; Hughes, Calder; Alfred, Kezia; Andersson, David; Chai, Yi; and Gao, Zhenqing (2014). Volvo 310X. Stanford Digital Repository. Available at: http://purl.stanford.edu/td675km9733",
