    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The algal wastewater treatment and resource recovery system is fed with primary effluent and has been operated in batch and fed-batch modes. This database covers measured biochemical oxygen demand, ammoniacal nitrogen, and phosphates in the system as a function off process time. Additional data on bacterial inactivation and struvite recovery are also included.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
