    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This standard operating procedure (SOP) is intended to provide general guidance on how to safely work with irritants. As irritation is only a secondary health effect with many substances, ensure to account for other more significant hazards such as carcinogenicity and corrosivity. If you have questions concerning the applicability of any item listed in this procedure contact the Principal Investigator/Laboratory Supervisor of your laboratory or Environmental Health and Safety (EHS_Research_SOP@lists.stanford.edu).",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
