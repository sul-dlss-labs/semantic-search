    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"Rose Foundation filed a citizen petition with the United States Securities Exchange Commission (SEC) asking for a crackdown on environmental accounting fraud and new regulations to guide future corporate environmental liability reporting. The petition was immediately endorsed by more than 30 other foundations, as well as several mutual funds and labor organizations. This report is part of the Environmental Fiduciary Report Series.\"--Rose Foundation document download page.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
