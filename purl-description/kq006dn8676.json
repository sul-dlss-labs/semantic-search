    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This is Episode 11 of the \"Sounds of Stanford\" PWR 2CG class, taught by Chris Gerben. This podcast explores the theme \"Behind the Scenes,\" as we explore, in-depth, three very interesting topics. Follow three Stanford students (Danni, Sohee, and Max) as they bring you on a journey through three subjects that they find important in their life, on the other side that the general public doesn't normally get to see. Take this opportunity to see martial arts, a cappella, and food trucks in a light that you've never seen them in before.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
