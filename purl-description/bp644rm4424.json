            "parallelValue": [],
            "groupedValue": [],
            "value": "Docking, J. (2024). Program Evaluation as a Learning Tool. Stanford Digital Repository. Available at https://purl.stanford.edu/bp644rm4424. https://doi.org/10.25740/bp644rm4424.",
            "type": "preferred citation",
