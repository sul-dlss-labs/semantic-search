    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "As part of a project examining temperature variation effects on intertidal communities, a series of experimental plates were deployed in the mid and high intertidal zone at Hopkins Marine Station, Pacific Grove, CA. A total of 3 deployments took place during late 2012 through early 2015, and in each deployment a set of 288 plates were set out, with or without herbivorous Lottia limpets, in order to track limpet growth and microalgae densities. Each month, a photograph of each plate was taken with a digital camera mounted on a frame, in order to provide a consistent orientation and distance of the camera relative to the flat plate surface. The collection here contains photographs of each plate through the months of each deployment, organized by plate number. Descriptions of the methods and treatment types are provided in the associated metadata files.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Denny, Mark W., Bengt J. Allen, and Luke P. Miller (2016). Field experimental plate photographs for Temperature Variation Effects on Intertidal Communities project. Stanford Digital Repository. Dataset. Available at: http://purl.stanford.edu/jn023kf3320",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "National Science Foundation OCE-1130095 to M. W. Denny and OCE-1131038 to B. J. Allen",
            "type": "funding",
