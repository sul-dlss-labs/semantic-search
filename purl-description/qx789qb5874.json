            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For accompanying photographs of the west wing see PC 067; the HABS architectural drawings are housed in the Stanford University Archives architectural drawings collection.",
