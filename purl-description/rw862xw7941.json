    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In this study, we introduce a new approach to water conservation that addresses regional dynamics among water utilities—a novel system of tradable water conservation credits. Through a proof-of-concept analysis, this study estimates the potential benefits of a trading program and demonstrates the institutional and economic characteristics needed for such a policy to be viable. We explore the impacts of defining different policy configurations, collaborative dynamics, and uncertain demand on the effectiveness and outcomes of a conservation credit policy. We demonstrate this proof-of-concept with a counterfactual case study in the San Francisco Bay Region during an emergency call for conservation.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Gonzales, P., Ajami, N. K., Sun, Y. J. (2017). U2.03 Gonzales 2017 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/rw862xw7941",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
