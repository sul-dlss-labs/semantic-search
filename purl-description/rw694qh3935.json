    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The items in this collection collate publicly available data about US\r\nelection participation. A best effort was applied to unifying data\r\nformats from databases between 2008 and 2018, so that analysis can be\r\nperformed easily across this time range. Beyond voter turnout, the\r\nmean turnout of years before a given election, as well as age and race\r\ndemograpics are provided, all in a single dataset. The content is\r\ncollated from the US Elections Project, and the Kaiser Family\r\nFoundation.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Collated Voter Turnout Results. Andreas Paepcke (ed.). Stanford University, https://purl.stanford.edu/rw694qh3935.",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The data originate from:\r\n- The US Elections Project Blog: \r\n    http://www.electproject.org/\r\n- The Kaiser Family Foundation\r\n    https://www.kff.org/other/state-indicator/distribution-by-age",
            "type": "citation/reference",
            "identifier": [],
            "displayLabel": "Related Publication",
            "note": [],
            "appliesTo": []
        }
