    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Translational Pharmacogenetics Project (TPP) is a PGRN-led initiative with the goal to operationalize the work of CPIC by translating widely accepted actionable pharmacogenetics discoveries into real-world clinical practice.\r\n\r\nTPP creates \"look up\" tables by gene which contain phenotype and clinical decision support system information based on haplotypes and diplotypes. These tables are a work in progress and are offered on PharmGKB \"as is\" until the tables become formalized.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Pharmacogenomics Research Network Translational Pharmacogenetics Program. (2017). Translational Pharmacogenetics Project (TPP) Look Up Tables By Gene. Stanford Digital Repository. Available at: https://purl.stanford.edu/yp464cc5056",
