    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For her capstone project, Lara Hafez worked alongside her classmate, Arshya Gaur, to compile a guide for the Residential Education (ResEd) system at Stanford University about how they can best improve Resident Assistant (RA) training and better equip RAs to handle sexual assault/harassment cases as they arise among students. This project was done for the course FEMGEN 143: One in Five: The Law, Politics, and Policy of Campus Sexual Assault, which examines precarious issues of sexual harassment and assault on university campuses across the U.S. The guide is based on survey data collected from current and past Stanford RAs about the efficacy of sexual harassment training and the room for improvement. The guide was shared with Residential Education with the hopes that the recommendations provided at the end of the guide become considered and implemented in the future.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hafez, L. (2024). Resident Assistants and Their Role as Mandated Reporters: Evaluation and Recommendations. Stanford Digital Repository. Available at https://purl.stanford.edu/xt441mh1600. https://doi.org/10.25740/xt441mh1600.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
