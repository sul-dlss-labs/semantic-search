    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This repository makes data and code available to readers of Ruijgrok, Paul V. and Ghosh, Rajarshi P. et al. (Nature Chemical Biology 2021), and relies on that published paper for context. Five archives are included in this collection. “Source Data for Figures 1-5”, \"Source Data for Extended Data Figures 3-4\", and “Source Data for Supplementary Figures 3-11” contain all the data presented in figure panels in the main text, Extended Data, and Supplementary Information, respectively. “Gliding Filament Analysis Code” includes MATLAB, Python, and Jython code used to process raw videomicroscopy data from gliding filament motility assays. \"Gliding Filament Sample Data\" contains a sample videomicroscopy dataset on the MyLOVChar4 construct, enabling a demonstration analysis using the provided code.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ruijgrok, Paul V. & Ghosh, Rajarshi P. et al. (2021). Supporting data and code for \"Optical control of fast and processive engineered myosins in vitro and in living cells\". Stanford Digital Repository. Available at: https://doi.org/10.25740/65j8-6114",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
