    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Visual Word Form Areas (VWFAs) are two regions of the brain that have been found to be selective for processing words. My objective in this project is to determine the extent to which each VWFA is selective for the task of reading versus the visual presentation of text stimuli. I tested this hypothesis by using functional Magnetic Resonance Imaging to scan subjects’ brains while they performed reading tasks and color-recognition tasks on English words formed by either text or emojis. The fMRI results allowed me to differentiate between neural responses from the different tasks and stimuli. My fMRI results suggest that the VWFAs are not selective for text stimuli; rather, they prefer emojis over text. Moreover, one or the other (depending on the participant) could be selective for the task of reading.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Jorgensen, Julia Grace. (2021). The Visual Word Form Areas Prefer Emojis to Text. Stanford Digital Repository. Available at: https://purl.stanford.edu/vn480br1366",
            "type": "preferred citation",
