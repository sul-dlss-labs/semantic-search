    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kyra Jasper's capstone examines the mechanisms of Indonesia's Human Rights Court system from 2006 to the present. Her research focuses on case studies highlighting Indonesia’s efforts to address gross human rights violations, drawing special attention to the efficacies and drawback of such efforts.\r\n\r\nStudent project deposited by department for archival purposes. Original work unavailable for public download due to permission restriction preferences of the author.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Jasper, K. (2023). Accountability at a Crossroads: Past Struggles and Future Perils of Indonesia’s Human Rights Court Process. Stanford Digital Repository. Available at https://purl.stanford.edu/kx929zs0125. https://doi.org/10.25740/kx929zs0125.",
