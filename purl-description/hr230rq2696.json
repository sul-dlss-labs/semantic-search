    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "What is the role of a marine science librarian in supporting marine science research? In this presentation I share how we've adopted the 'Collections as Data' approach to curating our unique collections, as well as some of the tools and workflows we used. I offer examples from some of our projects over the years. The goal for the talk is to share a bit about what we're up to at Miller Library, hopefully generate some conversation around historical biodiversity data and collections, and work toward building a community of practice around these things.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Whitmire, Amanda. (2023). Digital collections, biodiversity data, and the marine science librarian. Stanford Digital Repository. Available at https://purl.stanford.edu/hr230rq2696. https://doi.org/10.25740/hr230rq2696.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
