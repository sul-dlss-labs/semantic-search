    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "On June 4 1990, participants in the CIFE project \"Integrated Construction Planning\" held a one day retreat at Stanford University. This retreat was the conclusion of a series of meetings that had taken place in the preceding months to explore the broad issues involved in construction planning, particularly in the\r\ndomain of power plant construction.\r\n\r\nThe purpose of this retreat was also to prepare the second phase of this project,\r\nnamely the description of a prototype construction planner and possibly a demonstrative realization.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Nielsen, R. and Riitahuhta, A. and Levitt, Raymond E. and Latombe, Jean-Claude and Rit, J-F. and Wilson, R. and Zhu, D.. (1992). WP013: Integrated Construction Planning: A Problem Analysis. Stanford Digital Repository. Available at: http://purl.stanford.edu/bz278hc4860",
            "type": "preferred citation",
