    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis, which takes as its subject John Milton's epic poem Paradise Lost, is a marriage of prosody and reader-response theory: against critics who argue that Milton's rhythms demonstrate his political beliefs, this thesis argues that Milton's rhythms create certain tasks that train the reader in the qualities he needs to become the ideal republican and the ideal Christian.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
