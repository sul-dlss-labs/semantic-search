    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This research examines the development and implementation of two water data platforms, the Shasta Operations for Winter Run (SHOWR) and the Groundwater Recharge Assessment Tool (GRAT), and an additional 10 case studies. The study initially aimed to examine how these tools impact local or regional water management decisions. It was then expanded into a series of key findings and recommendations for how to build effective tools to inform decision-makers in the water field,",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Moran, T., A. Saracino, Z. Sugg, B. Thompson and J. Martinez. Evaluating the Use of Data Platforms for Water Management Decisions. Water in the West. Stanford Digital Repository. Available at: https://purl.stanford.edu/cb612zf3515.",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
