    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For his human rights capstone project, Evan Baldonado (he/him) created a webpage describing the status of student worker unionization across university campuses, providing statistics and graphs on the economic conditions motivating unionization, and featured an interactive map where users can see all the current student unions across the United States. This process for this project included researching and compiling a dataset on student unions to create and design the accompanying webpage. The webpage uses Mapbox GL JS and Chart.js. to display and convey this research data.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Baldonado, E. (2024). Student Worker Unionization in the United States. Stanford Digital Repository. Available at https://purl.stanford.edu/vs677sh8147. https://doi.org/10.25740/vs677sh8147.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
