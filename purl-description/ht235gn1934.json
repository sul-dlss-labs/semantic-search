    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This data-base contains the isotopic composition of both deuterium and oxygen-18, location, chemical, and physical data of more than 14,180 samples of surface and ground water from the states of Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, Washington, and Wyoming.  The sources for these data include published and unpublished data, and data on file in U.S. Geological Survey computer data bases.  The data is presented in tabular form and locations are plotted on maps of each state.  These tables are give in .pdf, .txt (tab-delimited), .csv (comma-delimited), .dbf, and .xls.  The report is in .pdf format.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
