    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In this project 198 manuscripts from 11th, 12th, and 13th centuries are selected as target for feature extraction. Some of them belong to one century while others have spanning of two or three centuries. The authors used different colors, shapes and decorations for organization of manuscripts which help readers for better understanding. The aim was to extract the salient color regions (characters) in these document images. After extraction of features, the goal was to classify them into four categories: i) Litterae Notabiliores, ii) Enlarged Capitals, iii) Rubric, and IV) Intertextual space.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
