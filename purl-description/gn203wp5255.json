    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast looks at the impact of sound on human emotion. Each segment of the podcast covers a different aspect of this theme, starting with a discussion of a capella culture, moving on to an analysis of the importance of rhythm and baseline, before ending with a discussion on the emotional aspects of a sports fanbase. This podcast includes interviews with the director of Mixed Company (a Stanford a capella group) and an interview with a Boston resident concerning the events of the Boston Bombing. The segment regarding rhythm and baseline looks at video games from SuperGiant games, such as Bastion and Transistor, and the music choices of the LSJUMB to demonstrate the similarities between music with similar rhythmic patterns, but different melodic influences and genres. \n\nOverall Length: 52 minutes",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
