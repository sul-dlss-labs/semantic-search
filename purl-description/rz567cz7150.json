    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "At this year’s ALA Annual Conference in Washington, DC, the ACRL European Studies Section, in collaboration with colleagues from Library of Congress and support from the Digital Scholarship Section, held a panel of digital humanities (DH) experts to discuss international trends, ongoing projects and initiatives in European Studies, as well as perspectives from researchers in the field. The goal of this program was to raise awareness and to encourage cooperation among scholars and librarians in DH and European Studies librarians.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
