    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Microwave impedance microscopy (MIM) is a mature scanning probe technique that has been widely used to characterize materials with macroscopic-level quantum effects. Currently, most MIM measurements are made using the same excitation and detection frequencies. In this thesis, we present the design and development of nonlinear MIM, which allows us to measure the nonlinear electrical susceptibility and conductivity of materials. Nonlinear MIM distinguishes itself from other forms of nonlinear measurement techniques for its simplicity and applicability to a wider range of material systems. Using finite element analysis, we further provide a physical interpretation of the nonlinear MIM signal. Moreover, nonlinear scans on a high-resistivity silicon anti-dot patterned heavy surface implantation were performed to show a proof-of-concept of our room-temperature implementation. This advancement paves the way for further studying quantum and topological systems, including imaging semiconductor carrier distributions, topological insulators, and ferroelectric polarization domains.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zhu, J. (2024). Developing Nonlinear Microwave Impedance Microscopy. Stanford Digital Repository. Available at https://purl.stanford.edu/mw375sr7697. https://doi.org/10.25740/mw375sr7697.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
