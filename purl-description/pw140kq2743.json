    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This Excel workbook contains all data from experiments described the corresponding manuscript. The first workbook page \"READ_ME\" contains information about the following two pages, including column name explanation and data description. The next two workbook pages contain data from the plaque assays and RT-qPCR experiments, respectively. In the data set, volunteer #, handwashing method, PFU, dilution, Ct, and Log reduction are some variables present. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Anderson, C., Tong, J., Zambrana, W., Boehm, A., and Wolfe, M. (2022). Complete Data Set for the Following Paper: Investigating the efficacy of various handwashing methods against enveloped and non-enveloped viruses. Stanford Digital Repository. Available at https://purl.stanford.edu/pw140kq2743",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
