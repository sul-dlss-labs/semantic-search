    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Serial section EM data with the following results.  Reminiscent of the microtubule phenotype observed in mec-17;atat-2 double mutants, mec-12 null mutant TRNs expressing MEC-12(K40R) harbored polymorphic microtubules. Because this substitution replaces lysine 40 with a positively charged residue that cannot be acetylated, this finding suggests that the post- translational modification per se is crucial for the formation or stability of 15-pf microtubules.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Cueva, Juan G. and Goodman, Miriam B. (2012). Serial section TEM of touch receptor neurons from transgenic mec-12 putative null expressing mec-12 K40R. Stanford Digital Repository. Available at: http://purl.stanford.edu/bz772xw6009",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
