            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains hydrographic and biogeochemical measurements made from samples collected from the 2014 SUBICE campaign. Data includes temperature, salinity, nutrients, nitrification rates, and other variables analyzed in the article \"Light, ammonium, pH, and phytoplankton competition as environmental factors controlling nitrification.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
