    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The datasets associated with the publication entitled ‘Mixed Imbibition Controls The Advance of Wetting Fluid in Multiscale Geological Media’ is attached. This includes both static and dynamic imaging datasets acquired on a naturally fractured Wolcamp sample using micro- and clinical-CT instruments. In particular, dry scans were obtained using micro-CT, whereas clinical-CT scans were acquired to characterize spatial porosity distributions as well as fracture-matrix interactions during brine imbibition.  The voxel dimensions of the 3D tomograms are (27×27×27) μm3 and (195×195×625) μm3 for micro- and clinical-CT, respectively. An additional 'Readme.txt' file is provided that contains detailed description of the each dataset including the key parameters set for the CT instruments.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kurotori, T., Murugesu, M., Zahasky, C., Vega, B., Druhan, J., Benson, S., and Kovscek, A. (2022). Dynamic Imaging of Mixed Imbibition Process in a Naturally Fractured Shale Rock using X-ray CT. Stanford Digital Repository. Available at https://purl.stanford.edu/nj176bd5255",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
