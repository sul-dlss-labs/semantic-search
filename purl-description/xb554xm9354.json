    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We studied the influence of temperature and precipitation on malaria in the Loreto Region of Peru, where the dominant malaria-causing parasite is Plasmodium vivax. We fit generalized additive models for 2-12 week lags to allow for nonlinear associations between malaria incidence and our exposures: mean daily temperature, mean daily temperature range, minimum daily temperature, total weekly precipitation, heavy rainfall, and high heat. Our findings suggest that short-term (3 weeks prior) variation in temperature is less correlated with vivax malaria burden than medium- term (12 weeks prior) variation in temperature. We found that in the short- term in the Loreto Region, periods of sustained, moderate rainfall may be associated with increased malaria incidence, and high heat events may be associated with decreased malaria incidence.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Barratt Hetimann, G. (2024). Associations between Weather and Malaria Risk in Loreto Region, Peru. Stanford Digital Repository. Available at https://purl.stanford.edu/xb554xm9354. https://doi.org/10.25740/xb554xm9354.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
