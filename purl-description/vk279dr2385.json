    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis looks at the current China-Russia relationship by looking at the Korean War era, the previous peak in the bilateral relationship between Beijing and Moscow. It studies recent works by Chinese scholars with the purpose of seeking insights and lessons about the bilateral relationship with Moscow during the Korean War era. The thesis shows that there are important lessons regarding PRC-USSR relationship to be drawn from China's Korean War experiences, and these lessons have implications for what China today expects out of the relationship with Russia.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Shou, J. (2022). \"Friendship with Limits\" -- Contemporary Chinese Evaluation of the Relationship with Russia via Study of the Korean War Memories. Stanford Digital Repository. Available at https://purl.stanford.edu/vk279dr2385. https://doi.org/10.25740/vk279dr2385.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
