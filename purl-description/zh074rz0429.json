    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Some vols. include supplemental journals of \"such proceedings of the sessions, as, during the time they were depending, were ordered to be kept secret, and respecting which the injunction of secrecy was afterwards taken off by the order of the House.\"",
            "identifier": [],
            "displayLabel": "Summary",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Began with: 1st Congress (Mar. 4/Sept. 29, 1789).",
            "type": "date/sequential designation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Vols. for -1953 issued in congressional serial set binding.",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Batchelder Collection: Supplemental journal, Dec. 6, 1805-Mar. 31, 1806. 1 v.",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Vols. for 1973- issued in two or more parts.",
            "type": "numbering",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Also issued (1789/91-1873/75) via the Internet from the Library of Congress web site. Address as of 4/8/1999: http://memory.loc.gov/ammem/amlaw/lwhj.html; current access is available via PURL.",
            "type": "additional physical form",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Some issues also available on CD-ROM as: <1991-> United States. Congress. House. Journal of the House of Representatives of the United States (CD-ROM).",
