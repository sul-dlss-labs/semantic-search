    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Data collected from two budget surveys (FY2021 in 2020 and FY2022 in 2021) in collaboration with the City of Austin budget department. Data contains preferences for each respondent and the day of their participation. \r\n\r\nIn the middle of the FY2021 survey, the murder on George Floyd by a police officer in Minneapolis and the subsequent protests resulted in nationwide upset and the number of daily responses increased about a hundredfold. The responses shifted significantly. \r\n\r\nFor FY2021, this data set contains 37,006 responses. For FY2022, this data set contains 1,525 responses. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Gelauff, L. and Goel, A. (2022). Austin Budget Survey Data FY2021 and FY2022. Stanford Digital Repository. Available at https://purl.stanford.edu/xd639dr9199",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
