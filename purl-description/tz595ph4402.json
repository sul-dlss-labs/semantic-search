    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This paper investigates the impact of video and text testimonials on willingness to pay\r\n(WTP). An experiment is run eliciting WTP for three different ungendered products\r\nwhere participants see a photo of the product and either a male or female video testi-\r\nmonial, a text testimonial, or no testimonial. We find that the female video testimonial\r\nsignificantly decreases WTP, while the male video testimonial and the text testimonial\r\nhave approximately no effect. Additionally, the text testimonial leads to a significantly\r\nhigher retention of factual information presented as compared to the video testimonial\r\ntreatment. These results support the hypothesis that consumers’ engagement in video\r\ntestimonials is more focused on the presenter than the product.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hilderbrand, N. and Bernheim, B. (2023). . Stanford Digital Repository. Available at https://purl.stanford.edu/tz595ph4402. https://doi.org/10.25740/tz595ph4402.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
