    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This package provides an independent evaluation approach to validate the fairness, bias, and generalizability of ML models developed by the OHDSI Patient-Level-Prediction (PLP) R package over internal and external validation. This package uses the PLP model's internal and external validation results to calculate model performance across various population subgroups, such as race, ethnicity, gender, Charlson comorbidity severity groups, and any defined vulnerable and risky groups.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Naderalvojoud, B., Asch, S., Curtin, C., Humphreys, K., and Hernandez-Boussard, T. (2024). FairGenEval: Fairness, bias, and generalizability evaluation of OHDSI-developed ML models using OMOP CDM. Stanford Digital Repository. Available at https://purl.stanford.edu/tn943gx3238. https://doi.org/10.25740/tn943gx3238.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
