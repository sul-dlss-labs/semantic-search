    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This ePortfolio is a work created out of my science communication artifacts since my first quarter at Stanford. The goal of this ePortfolio is to show my abilities as a science communicator while demonstrating how I’ve grown, adapted, and found my possible lifelong interests. It contains science communication artifacts in various modes (from text, to visual, to auditory modes) and genres (from research papers, to infographics, to easily accessible podcasts), detailing the breadth of my experience in science communication. Ultimately, it is a capstone requirement for the Notation in Science Communication, but it also served as an opportunity to reflect on my experience and growth as a science communicator at Stanford.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
