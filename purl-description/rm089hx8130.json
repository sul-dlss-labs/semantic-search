            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Wilson, Chris, et. al. (2008). From Outcrop to Flow Simulation: Constructing Discrete Fracture Network Models from LiDAR Surveys. Stanford Digital Repository. Available at: http://purl.stanford.edu/rm089hx8130",
