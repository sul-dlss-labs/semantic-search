    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This spreadsheet contains information on the sewershed sample SARS-CoV-2 RNA and PMMoV RNA concentrations used as a supplemental data in Kim & Boehm \"Wastewater monitoring of SARS-CoV-2 RNA at K-12 schools: Comparison to pooled clinical testing data\". The data was acquired from the regional monitoring program (Sewage Coronavirus Alert Network) to be used in a supplementary manner to examine association between school wastewater data and that of the bigger community.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kim, S. (2022). Supplemental Sewershed Data. Stanford Digital Repository. Available at https://purl.stanford.edu/km945rd8103. https://doi.org/10.25740/km945rd8103.",
            "type": "preferred citation",
