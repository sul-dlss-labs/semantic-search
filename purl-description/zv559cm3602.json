    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Control of nitrogen in municipal wastewater effluent is one of the key challenges facing wastewater treatment plants (WWTPs). Natural treatment systems provide a cost-effective means of removing nitrate from wastewater effluent and can simultaneously support wildlife habitat and create recreational opportunities. A potential application of this is to use systems similar to subsurface flow wetlands between existing flood control levees and the tidal mud flats that line much of San Francisco Bay (SF Bay). These “horizontal levees” provide a means of removing nitrate, creating wildlife habitat and protecting coastal levees from storm surges. The horizontal levee at Oro Loma Sanitary District will be a demonstration-scale experimental wetland system based on this concept. This system will be monitored to evaluate the ability of these systems to polish wastewater effluent.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Cecchetti, A. R., Fusi, S., Herzog, S., Warner, J., Diaz, C., Lowe, J., McCray, J. E., Boehm, A. B., Horne, A. J., & Sedlak, D. L. (2016). N1.03 Cecchetti 2016 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/zv559cm3602",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Cecchetti, A. R., Stiegler, A. N., Graham, K. E., & Sedlak, D. L. (2020). The horizontal levee: a multi-benefit nature-based treatment system that improves water quality and protects coastal levees from the effects of sea level rise. Water Research X, 100052. https://doi.org/10.1016/j.wroa.2020.100052",
            "type": "citation/reference",
