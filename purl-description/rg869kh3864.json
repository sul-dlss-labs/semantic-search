    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Racial literacy requires critical thinking to assess situations or texts for inequalities, which is part of comprehensive information literacy skills. As society is making more of an effort to value underrepresented groups’ experiences, we need to make that same type of progress in libraries. Many diversity discussions highlight gross disparities in wages and leadership positions. I will focus on the diverse array of vernaculars spoken by library patrons and staff, or “linguistic diversity.”",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Smith, Felicia A. (2018). Linguistic Diversity in Libraries. Stanford Digital Repository. Available at: https://purl.stanford.edu/rg869kh3864",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
