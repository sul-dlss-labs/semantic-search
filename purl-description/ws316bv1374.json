    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Time-series data on kelp abundance from the Monterey Peninsula, California, USA. These data were collected primarily by students in a summer kelp forest ecology course at Hopkins Marine Station (BIOHOPK185; Ecology and Conservation of Kelp Forest Communities). James Watanabe conceived the study and led the surveys from 1992-2018. From 2019-present, Robin Elahi continued the kelp monitoring with the summer kelp forest ecology course.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Elahi, R. and Watanabe, J. (2023). Time-series data on kelp abundance from the Monterey Peninsula, California, USA. Stanford Digital Repository. Available at https://purl.stanford.edu/ws316bv1374. https://doi.org/10.25740/ws316bv1374.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
