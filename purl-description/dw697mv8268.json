    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Future Lab Africa was created in 2015 as part of the Post African Futures Exhibition and has been an ongoing research and experimental digital project created by Jepchumba. The podcast serves as an interactive African contemporary traditional sci-fi storytelling space that engages African cultures of technology through critical aesthetic explorations in Africa. The series is a call to explore African modes of science and technology outside of lab spaces and innovation labs. We seek to find what technology, science, nature, the environment and the nature of experimentation really mean in the context of African people’s lived realities.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Kalu, M. (2024). Future Lab Africa: The Intersection of Art and Tech in African Contexts. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/dw697mv8268/version/1. https://doi.org/10.25740/dw697mv8268.",
            "type": "preferred citation",
            "identifier": [],
