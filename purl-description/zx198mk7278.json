    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A thesis exploring the intersection between narratology and dramatic literature using three plays by Samuel Beckett: Krapp's Last Tape, Happy Days, and Waiting for Godot. Through the employment of narrative entropy, these three plays yield significant challenges to the picture of life-as-narrative, interrogating both the dramatic form and the narrative form using the literary-performative combination of both.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
