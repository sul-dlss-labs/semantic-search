    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This report sounds the alarm on the breakdown of job-based health coverage, providing a full results of the health insurance analysis performed jointly by Working Partnerships USA and the UC Berkeley Center for Labor Research and Education. It finds that employer-based health insurance declined between 2000 and 2004 and is now insuring only 57% of Californians and about 62% of those nationally.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Arindrajit Dube, PH.D. and Ken Jacobs, UC Berkeley Center for Labor Research and Education, Sarah Muller, Bob Brownstein and Phaedra Ellis-Lamkins, Working Partnerships USA.",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"January 2006.\"",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
