    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "I created a scavenger hunt to augment my library workshop that requires students to unscramble a book title containing profanity, search the catalog to find its location, and retrieve it from the shelves. “The Rebellion of The Beasts: Or, the Ass is Dead! Long Live the Ass!” is a sample title. It makes retreiving books a lot more interesting and proves that libraries do not censor.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
