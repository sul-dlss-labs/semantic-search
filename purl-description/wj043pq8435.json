    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This is the final report for the Learning Design and Technology project Re-Ignite, a card game developed to address teacher retention. Through needfinding and co-designing prototypes with educators, Re-Ignite is built on a solid foundation. There is evidence from extensive user testing that Re-Ignite engages educators in meaningful conversations. The ultimate goal of Re-Ignite is to increase educator belonging and agency, helping to keep teachers engaged and sustained in their profession. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Higgins, H. (2022). Re-Ignite: Connecting educators to their values and one another. Stanford Digital Repository. Available at https://purl.stanford.edu/wj043pq8435",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
