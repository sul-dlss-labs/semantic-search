    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Steady-state fluid flow is modeled through idealized, two-dimensional fracture networks in order to explore how fracture geometry in simple\r\nfault zones controls overall fault-zone permeability. Emphasis placed on using fracture geometries that incorporate the mechanical origin of fractures within fault zones. The results lead to first-order conclusions about the fluid-flow properties of natural fault zones based upon examples where the fracture geometry is readily observed in outcrop.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
