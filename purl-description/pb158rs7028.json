    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The deliverables being uploaded have been created for the Stanford Policy, Organization, Leadership, Studies culminating Field Project. The masters recipient, Kayla Constandse, undertook this research to identify opportunities to address collegiate student-athlete mental health crises, particularly exacerbated by the COVID-19 pandemic. The findings demonstrate the necessity for athletic departments to further invest in their coaches.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Constandse, K. (2023). We Miss 100% of the Shots We Don't Take: Identifying Opportunities in Mental Health Services for Collegiate Student-Athletes.. Stanford Digital Repository. Available at https://purl.stanford.edu/pb158rs7028. https://doi.org/10.25740/pb158rs7028.",
            "type": "preferred citation",
