    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Multiple linear regression (MLR) models were built to assess the environmental variables that influence the depth and magnitude of the PNM feature in the ETNP. The first set 45 of MLR models (“full” models) used semi-continuous measurements (temperature, density, oxygen, chlorophyll fluorescence, PAR, nitrate, nitrite and ammonium) from CTD/PPS casts collected at 16 stations on the 2016 cruise to predict nitrite concentration.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Travis, N., Kelly, C., Mulholland, M., and Casciotti, K. (2022). R Code for multiple linear regression analysis for ETNP primary nitrite maximum data. Stanford Digital Repository. Available at https://purl.stanford.edu/bf589mh2984. https://doi.org/10.25740/bf589mh2984.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
