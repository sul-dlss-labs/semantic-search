    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dataset used for the publication of \"Cross-validation of independent ultra-low-frequency (ULF) magnetic recording systems for active fault studies\". Two independent ULF magnetic systems were set up at Jasper Ridge Biological Preserve (JRSC) from March 31 – May 13, 2014 in Portolla Valley, CA, an existing  permanent site at the Jasper Ridge Biological Preserve of Stanford University  and a temporary QuakeFinder installation. The two systems were separated by approximately 50 m to eliminate interference, but both systems share the low-noise local environment.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Wang, C, Bin, C, Christman, LE, Glen, JMG, Klemperer, SL, McPhee, DK, Kappler, KN, Bleier, TE, and Dunson, JC. (2014). Cross-validation of independent ultra-low-frequency magnetic recording systems for active fault studies. Stanford Digital Repository. https://purl.stanford.edu/cn185mb0456",
