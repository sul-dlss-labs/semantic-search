    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "With this contribution, we introduce a search engine and a related database for the entire body of materials contained within the Rock Fracture Project (RFP) workshop volumes and field trip guidebooks. The database has been organized in the form of tables corresponding to years and volume numbers of the RFP workshop volumes and titles, authors, geographic locations, and keywords for the individual workshop contributions and field trip guidebooks. Upon entering a query in the form of a full or partial phrase or a word, the search engine provides the best matches from the database. By clicking on any link in the list of the best possible matches the original document in PDF format can be accessed. In summary, it is now possible to search and retrieve information from the entire RFP publications library using fundamental structures, certain regional structures, deformation processes, geographic locations, theoretical methods, year, full or partial title, and author name.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zhong, Jian, Smith, Julie and Aydin, Atilla. (2008). Database and Search Engine for the RFP Publications. Stanford Digital Repository. Available at: http://purl.stanford.edu/wr034ss8331",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        }
