    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In January 2021, Seattle became the second city in the nation to implement a minimum pay standard for rideshare drivers. In this thesis, I present a set of difference-in-difference models using Chicago as a control city that estimate the change in rideshare use that occurred in Seattle after the minimum pay standard. I find that the minimum pay standard was associated with a statistically significant decrease in ride volumes in Seattle. This decrease only occurred on weekdays, was larger during off-peak periods, and was greatest in low-income areas. Due to the limitations of this work, particularly those caused by the Covid-19 pandemic, more research should be undertaken to determine the exact causal effects of minimum pay standards.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hamilton, J. (2024). Driver Minimum Wage and the Market for Rideshare in Seattle . Stanford Digital Repository. Available at https://purl.stanford.edu/pv230mb2675. https://doi.org/10.25740/pv230mb2675.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
