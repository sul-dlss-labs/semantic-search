    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The KISS Controller is used to create time-lapse videos or to take scheduled video recordings from a single position using a Smartphone Camera. The KISS Controller is operated by a web based user interface running on a Smartphone or Laptop to direct the sequence of the video recording or photographs to create a time lapse video.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
