    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "These three files are faceted exports of John Locke's ego-network. Each displays one of the many metadata categories collected about Locke's correspondents. A full version of this visualization will allow the viewer to browse among around twenty different categories of information. These visualizations correspond to the article on Locke's ego-network and are best appreciated in the context of the other articles produced as a part of the Mapping the Republic of Letters project.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Willan, Claude. Visualizations of Locke's Correspondence Network. Stanford Digital Repository. Available at: http://purl.stanford.edu/gx970nw8882",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
