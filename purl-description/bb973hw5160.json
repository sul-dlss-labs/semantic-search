            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Diaz Reyes, Jose; Hiss, Eli; Luna, Autumn; Vasquez, Marco. (2021). Automated Coal Feeding Device for Zig Zag Brick Kilns. Stanford Digital Repository. Available at: https://purl.stanford.edu/bb973hw5160",
            "type": "preferred citation",
