    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This project explores new approaches for removing contaminants in stormwater during\r\ninfiltration, as well as protecting surface water and aquifers from the effects of contaminants in urban runoff. By developing a fundamental understanding of the mechanisms of contaminant removal in the laboratory and testing system performance at\r\nthe test-bed scale, our research will advance efforts to improve water quality and augment local water supplies through distributed capture, treatment, and recharge systems.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ashoori, N., Halaburka, B., Teixido, M., Spahr, S., Sedlak, D. L., and Luthy, R. G. (2018). N2.05 Ashoori 2018 ReNUWIt Annual Meeting Poster. Stanford Digital Repository. Available at: https://purl.stanford.edu/wr902wx8691",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Luthy, R. G., & Sedlak, D. L. (2017). Enhanced Removal of Nutrients and Trace Organic Contaminants in Pilot-Scale Stormwater Treatment Systems (4567). Retrieved from http://www.waterrf.org/Pages/Projects.aspx?PID=4567",
            "type": "citation/reference",
            "identifier": [],
            "displayLabel": "Related Publication",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ashoori, N., Teixido, M., Spahr, S., LeFevre, G. H., Sedlak, D. L., & Luthy, R. G. (2019). Evaluation of pilot-scale biochar-amended woodchip bioreactors to remove nitrate, metals, and trace organic contaminants from urban stormwater runoff. Water Research, 154, 1-11. http://doi.org/10.1016/j.watres.2019.01.040",
            "type": "citation/reference",
