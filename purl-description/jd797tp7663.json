    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A new Stanford Internet Observatory report investigates networks on Instagram and Twitter that are involved in advertising and trading self-generated child sexual abuse material (SG-CSAM). Our investigation finds that large networks of accounts, purportedly operated by minors, are openly advertising SG-CSAM for sale on social media. Instagram has emerged as the primary platform for such networks, providing features that facilitate connections between buyers and sellers. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Thiel, D., DiResta, R., and Stamos, A. (2023). Cross-Platform Dynamics of Self-Generated CSAM. Stanford Digital Repository. Available at https://purl.stanford.edu/jd797tp7663. https://doi.org/10.25740/jd797tp7663.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
