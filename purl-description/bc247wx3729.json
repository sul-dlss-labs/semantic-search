    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Act 2, scene 4, from the opera Richard Cœur-de-Lion by Grétry.",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Reproduction of manuscript held by Bibliothèque nationale de France, L18299.",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This manuscript comprises two parts, each showing the individual character's vocal part with bass line. The first part, pages [1-2] and [7-10], is Blondel's solo vocal part and duet (with Richard) at end of scene. The second part, pages [3-6], is Richard's solo vocal part and duet (with Blondel) at end of scene. Parts contain some measures showing other character's vocal line intended as cues; duet shows both vocal lines together with bass line.",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
