    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Calibrating nitric oxide (NO) and nitrogen dioxide (NO2) on a Teledyne T200P NOx analyzer using bottles of NO and NO2 at desired concentrations. This SOP demonstrates how this analyzer can be calibrated by flowing gas through a T connection at a flow rate 3x that of the instrument inlet flow and exhausting remaining gas out through a fume hood. First, calibrate instrument with zero air and upper NO concentration. Lastly, calibration of conversion efficiency (CE) for NO2 at upper and lower NO2 concentrations.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Finnegan, C. and Jackson, R. (2023). SOP for Calibration of Teledyne T200P NOx Gas Analyzer, nitric oxide and nitrogen dioxide (NO and NO2). Stanford Digital Repository. Available at https://purl.stanford.edu/by979yj2422. https://doi.org/10.25740/by979yj2422.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
