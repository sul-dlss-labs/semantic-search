    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Stanford Public Policy Practicum Program was assigned the task of conducting the preliminary analysis necessary to determine the feasibility of a shuttle program that is listed as 1 of 43 actions on the City of Millbrae’s 2020 Climate Action Plan (CAP). If the City of Millbrae chooses to proceed, this memo will provide data so that the City of Millbrae can make well informed decisions during the initial steps of implementation. Our approach consisted of gathering data on best practices in neighboring shuttle programs, conducting interviews with stakeholders and professionals in transportation, estimating the reductions in GHG relative to their costs and situating all this information within the specific context of Millbrae to make recommendations on what would work best.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Casey, C., Lee, L., and Vaughan, C. (2024). Preliminary Analysis of Local Shuttle Service: Prepared for the City of Millbrae. Stanford Digital Repository. Available at https://purl.stanford.edu/cj065mz9424. https://doi.org/10.25740/cj065mz9424.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
