    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "California’s Renewables Portfolio Standard (RPS) acts as one of the State’s keystone climate\r\nchange policies as it dictates the percentage of renewable energy that electricity providers must\r\nprovide their ratepayers. In this paper, I outline the difficulties and high incremental costs\r\nassociated with continuing to increase the level of the RPS. In response to these high costs, I\r\npropose a policy that would lead to significantly greater GHG emissions at a lower cost. This\r\npaper describes how the policy would work and how it could be implemented by the State of\r\nCalifornia to reduce the State’s impact on climate change.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rogers, S. (2022). Achieving Greater Greenhouse Gas Reductions with Alternative Compliance to California's Renewables Portfolio Standard. Stanford Digital Repository. Available at https://purl.stanford.edu/fq803bg4804",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
