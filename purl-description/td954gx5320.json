    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Super-resolution microscopy and confocal microscopy were used to characterize the location patterns and their cellular locations of the viral genomic RNA and viral proteins for the case of the SARS-CoV-2 virus infecting mammalian cells. Evidence is presented that RNA replication occurs in membrane bound replication organelles. This deposit provides the online source data for the analysis figures and the analysis codes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Andronov, L., Han, M., Zhu, Y., Balaji, A., Roy, A., Barentine, A., Patel, P., Garhyan, J., Qi, L., and Moerner, W. (2024). Source Data and Code for Nature Communications submission:  Nanoscale cellular organization of viral RNA and proteins in SARS-CoV-2 replication organelles. Stanford Digital Repository. Available at https://purl.stanford.edu/td954gx5320. https://doi.org/10.25740/td954gx5320.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
