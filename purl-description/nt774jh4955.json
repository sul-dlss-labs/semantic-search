    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Wildfire risk is a serious and growing concern for electric utilities. For the increasing number of utilities that are currently exposed to wildfire risk or are likely to be exposed to wildfire risk in the near future, creating and implementing a wildfire mitigation plan is a crucial step toward limiting overall risk. The knowledge of utilities and regulators in regions that have already experienced catastrophic wildfires and developed solutions to reduce the potential harms posed by wildfire is a key information source that can assist in this adaptation and improvement process. Many utilities, particularly in the Western United States, have already developed a robust set of actions and practices to mitigate wildfire risk.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Macomber, E., Wara, M., and Mastrandrea, M. (2024). Wildfire: Assessing and Quantifying Risk Exposure and Mitigation Across Western Utilities . Stanford Digital Repository. Available at https://purl.stanford.edu/nt774jh4955. https://doi.org/10.25740/nt774jh4955.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
