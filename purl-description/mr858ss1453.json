    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Included in this supplement to Lau et al. (2016) is the R code used to explore controls on d238U and [U] in seawater (U model.R) (Figures 1 and S6). We also include the R code used to explore the links between the OMZ and the carbon cycle (Figures 4, S8).\r\n\r\nWe make this code available without restriction for any purpose as long as the original paper is properly cited.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
