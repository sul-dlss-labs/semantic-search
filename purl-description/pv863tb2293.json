    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "These CAD artworks were generated by Joo Yong Sim's PhD program especially for machining strain array base plates and other accessories for experiments regarding his dissertation, \"MICROSYSTEMS TO STUDY THE MECHANOBIOLOGY OF CELL ADHESION\". \r\n\r\n1 Strain Array 25 Well Base Plates & Molds\r\n2 Stonehenge Base Plates & Molds\r\n3 Uni-axial Strain Array Base Plates & Molds\r\n4 Strain Array 6 Well Designs Plates & Molds\r\n5 Fixture Designs for Strain Array Controller\r\n6 Helpful Things for Cleanshop Supplies\r\n7 HPCENSE with Clifton\r\n8 Cantilever Shelves",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "C. S. Simmons, J. Y. Sim, P. Baechtold, A. Gonzalez, C. Chung, N. Borghi, and B. L. Pruitt. (2009-2013). Joo Yong Sim's Dissertation Supplemental Files: Strain Array & Other Machining CAD files. Stanford Digital Repository. Available at: http://purl.stanford.edu/pv863tb2293",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sim, Joo Yong. \"Microsystems to study the mechanobiology of cell adhesion\" PhD Dissertation, Stanford University, 2015. Available at https://purl.stanford.edu/th550kv3016",
            "type": "citation/reference",
            "identifier": [],
            "displayLabel": "Related Publication",
