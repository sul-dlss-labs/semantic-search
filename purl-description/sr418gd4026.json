    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Transcribe.it is a tool to help journalists transcribe audio files. This tool is intended to be run locally on a user's machine, in the spirit of tools such as OpenRefine and Tabula. It provides a simple web interface that lets users transcribe audio files using Google Cloud services, and saves the transcription locally. Transcribe.it is one of many solutions journalists can use to transcribe audio files, but this tool aims to simplify the process in a cost-effective way to the user without having to interact directly with Google’s Speech-to-Text API.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mercedes, Dilcia. (2019). Transcribe.it: Audio Transcription Made Simple. Stanford Digital Repository. Available at: https://purl.stanford.edu/sr418gd4026",
