    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Recent economic and environmental changes have severely threatened the ancient practice of Maya stingless beekeeping (meliponiculture). My research in southern Mexico and northern Belize examines the factors that influence the resilience of Yucatec Maya stingless beekeeping where it still exists. The circumstances that surround the survival of this tradition involve a reliance on traditional Maya medical theory and reflect an overarching pattern of conflict and resistance that exists between indigenous subsistence and western capitalistic economies. Understanding the cultural context of stingless bee honey is critical for examining the implications of commercialization. Of special interest are the changing gender roles involved in meliponiculture.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dezso, Genevieve (2014). Cultural Factors in the Survival of Stingless Bee Domestication (Meliponiculture) among the Yucatec Maya. Stanford Digital Repository. Available at: http://purl.stanford.edu/dm335yc4945",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        }
