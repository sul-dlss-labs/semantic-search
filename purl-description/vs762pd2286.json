    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "John Eastman, a conservative lawyer working with then-President Donald Trump's legal team, outlined in a six-page memo of January 3, 2021 a scheme to try to persuade then-Vice President Mike Pence to subvert the Constitution and throw out the 2020 election results on January 6. The memo was obtained by The Washington Post's Bob Woodward and Robert Costa, the authors of \"Peril,\" and a two page version was subsequently obtained and published by CNN. The original six page version was later posted by CNN, The memo, which has not previously been made public, provides new detail showing how Trump and his team tried to persuade Pence to subvert the Constitution and throw out the election results on January 6, 2021.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "At head of title: \"Privileged and confidential\"",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Description based on online resource; title from PDF title page (CNN, viewed October 11, 2021)",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
