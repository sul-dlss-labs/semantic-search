    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This data set contains the computational models for the paper on selecting representative models published in Computers & Geosciences. \r\nExample_1_100x100_conditional_models.zip contains log-permeability realizations of size 100x100 with bimodal permeability distribution. These realizations are conditioned to hard data at well locations. For obtaining the (isotropic) permeability values, use k=exp(m). \r\nExample_2_100x100_unconditional_models.zip contains log-permeability realizations of size 100x100 with bimodal permeability distribution. These realizations are unconditional (i.e., no hard data). For obtaining the (isotropic) permeability values, use k=exp(m).",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Shirangi, M. G., & Durlofsky, L. J. (2016). A general method to select representative models for decision making and optimization under uncertainty, Computers & Geosciences 96: 109-123.",
