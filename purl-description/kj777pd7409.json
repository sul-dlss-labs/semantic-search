    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast is the second act in the episode of Sounds of Stanford named \"Sighting In\", which was produced for the Spring 2014 PWR2 Sounds of Stanford class. It explores the importance of vulnerability to human connection through personal stories and narrative. Further, the podcast considers how we can encourage one another to embrace vulnerability more in our lives. Subtopics also touched upon are vulnerability in males specifically and the idea of being more vulnerable with strangers than friends.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
