    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In this study, sediment samples from in and around the New Idria mining district were analyzed to determine the speciation and concentration of mercury as it exits the mine site and travels toward the San Joaquin River. Results from this study lay the groundwork for future research on New Idria and its contribution to mercury in the San Joaquin River and San Francisco Bay. Ultimately, these data may provide the basis for policy decisions regarding remediation of the New Idria mining district, with the potential for positive impact on the health of San Francisco Bay.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
