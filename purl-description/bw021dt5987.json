    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This story examines how Senate Bill 1421, a California transparency law that went into effect in January 2019 that made public police use-of-force and misconduct records, has helped the families of police shooting victims by giving them access to internal investigation reports and body camera footage. Additionally, it looks at other pushes from activists and legislators in the state to increase police transparency and accountability. This story focuses on the shootings and family members of Oscar Grant, Antonio Guzman-Lopez, Jacob Dominguez and Richard “Pedie” Perez.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Richards, Connor Morgan. (2019). ‘A little more insight’: How California’s new transparency law is helping the families of those killed by police. Stanford Digital Repository. Available at: https://purl.stanford.edu/bw021dt5987",
            "type": "preferred citation",
