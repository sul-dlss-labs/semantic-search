    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Education is one of the possible ways that we might seek to limit the impact of globalization by ensuring that the population is up to date with skills. This would ensure that the population continues to be economically productive.  Many governments and international organizations have introduced systems, initiatives, and programs in their quest to produce a population who are lifelong learners that can face the challenges in a globalized world. Singapore is one such country that is also embarking on this journey. This qualitative study aims to share insights into 7 Singaporeans' journey on continuing education after they have started work.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Chan, C. (2022). Qualitative Study of Adult Learners in Singapore. Stanford Digital Repository. Available at https://purl.stanford.edu/hk953ms9144",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
