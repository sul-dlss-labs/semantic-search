    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For her human rights capstone project, Sam Churovich wrote a paper detailing a history and overview of modern international human rights law, focusing on the Universal Declaration of Human Rights, the United Nations, and other international politics. Moreover, her paper considers the significance and legacies of international tribunals, specifically evaluating the International Criminal Tribunal for Rwanda (ICTR) & The International Criminal Tribunal for the Former Yugoslavia (ICTY) and their overall role in influencing sexual violence prosecution under international law. \r\n\r\nStudent project deposited by department for archival purposes. Original work unavailable for public download due to permission restriction preferences of the author.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Churovich, S. (2023). A Review of International Law: Origins, Courts, and Sexual Violence as Understood Through the International Criminal Tribunal for Rwanda (ICTR) & The International Criminal Tribunal for the Former Yugoslavia (ICTY). Stanford Digital Repository. Available at https://purl.stanford.edu/mh874yb8300. https://doi.org/10.25740/mh874yb8300.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
