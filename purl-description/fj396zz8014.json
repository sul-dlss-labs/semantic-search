    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains Shazam query timings ('offsets') and query dates corresponding to 20 hit songs from the Billboard Year End Hot 100 2015 chart. Queries were aggregated from 1 January 2014 to 31 May 2016, inclusive. Number of queries per song range from 3,020,785 to 19,974,795, with a total of 188,271,243 queries across the 20 songs. Data are stored in .csv files (one file per song) ranging in size from 62.9MB to 416.1MB. The total size of the dataset is around 4GB.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
