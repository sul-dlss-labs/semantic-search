    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This repository contains photographs of quadrats taken along the Hewatt transect, located in the Hopkins Marine Life Refuge, Pacific Grove, California. From 2015 to 2018 photos were taken by Jim Watanabe. From 2019-present, photos were taken by Robin Elahi. Photoquadrats are organized in folders by year; each yearly folder is uploaded to the Stanford Digital Repository as a zip file.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Elahi, R. and Watanabe, J. (2023). Hewatt transect photoquadrats. Stanford Digital Repository. Available at https://purl.stanford.edu/nr783rs2739. https://doi.org/10.25740/nr783rs2739.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
