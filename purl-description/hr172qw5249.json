    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This essay won or received an honorable mention for The Boothe Prize for excellence in first-year writing. The Boothe Prize recognizes and rewards outstanding expository and argumentative writing by undergraduate students in first-year classes that satisfy the WR 1 requirement. In each award-winning essay, student writers demonstrate clarity of argument, excellent integration of research-based evidence, and compelling prose style.\r\nThis essay puts two disparate fields -- genetics and copyright -- into the same conversation. The author examines bacterial evolution as a lens through which to view copyright, offering principles to guide a model for copyright reform in an era of digital music sampling and mixing.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
