    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This collection contains data for the article titled \"Engineering a molecular electrocatalytic system for energy-efficient ammonia production from wastewater nitrate.\" These data include NMR and XPS spectra, aqueous nitrate and ammonia/ammonium mass balances for controlled-potential electrolysis and electrocatalyst-in-a-box (ECaB) experiments, electrochemical data used to calculate energy consumption for ECaB experiments, and worksheet and tabulated results of ECaB cost assessment.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Miller, D. (2024). Data files for \"Engineering a molecular electrocatalytic system for energy-efficient ammonia production from wastewater nitrate\". Stanford Digital Repository. Available at https://purl.stanford.edu/sk954gp2933. https://doi.org/10.25740/sk954gp2933.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
