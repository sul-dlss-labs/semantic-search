            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Tagal, Joyce. (2020). No-One Else Was in the Room Where It Happened: A legislative solution to party-switching in Malaysia. Stanford Digital Repository. Available at: https://purl.stanford.edu/cc272xz8182",
            "type": "preferred citation",
