    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"Media have played an important role in framing the public debate on the “refugee crisis” that peaked in autumn of 2015. This report examines the narratives developed by print media in eight European countries and how they contributed to the public perception of the “crisis”, shifting from careful tolerance over the summer, to an outpouring of solidarity and humanitarianism in September 2015, and to a securitisation of the debate and a narrative of fear in November 2015.\"--Document home page.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Myria Georgiou, Rafal Zaborowski.",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
