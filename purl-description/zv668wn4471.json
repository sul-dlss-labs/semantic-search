    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In my senior project called “Garden From the Concrete”, I explore how Asian college-aged women survivors’ process of healing from sexual assault while being situated in a red-state through a collaborative photo book. In preparation of the collaborative photo book, I reached out to Asian college-aged women sexual assault survivors in my home-state, which is Oklahoma. I gave the participants the prompt of “Describe your process of healing from sexual assault in a conservative community as an Asian college-aged woman in six pictures.” As photography can provide barriers to entry as it is an expensive hobby, I allowed my collaborators to include any pictures that were financially sustainable for them. As a result of four collaborators (including myself), I gathered film photos and digital photos (from both phone photography and professional camera photography).",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Nguyen, A. (2023). Garden From the Concrete Photo Book and Writer's memo. Stanford Digital Repository. Available at https://purl.stanford.edu/zv668wn4471. https://doi.org/10.25740/zv668wn4471.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
