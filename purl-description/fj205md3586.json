    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Imaging of fault-matrix fluid exchange is often difficult. We are developing a method to characterize fluid exchange between a fault zone and the surrounding matrix for several faults at two sites in the Santa Maria Basin, California. Thermal alteration associated with combustion of the hydrocarbon material within the fault zones will be quantified and will, along with measured hydrocarbon-occupied pore volume and the related permeability, form the basis for a thermal model. This thermal model will be examined as an analogy for fault-matrix fluid flow.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
