    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This corpus of data firstly outlines the buildings within New York City which are reporting energy data. Monthly energy data with a matching label is then linked to each building via unique identifiers. Finally the results of a query using Google Earth Engine is included as part of the core data. Intermediate directories, listed by number and letter, contain intermediate results from the analysis.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dougherty, T. (2023). Companion Data for the journal article \"Invisible walls: Exploration of microclimate effects on building energy consumption in New York City\". Stanford Digital Repository. Available at https://purl.stanford.edu/sz846yd5641. https://doi.org/10.25740/sz846yd5641.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
