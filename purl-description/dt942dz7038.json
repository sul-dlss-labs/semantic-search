    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Rhetorical analysis of the Hoover Institution Library & Archives' Frederick L. Felton Letters, exploring how the American prosecutor describes \"Germans\" as a collective group during and at the Nuremberg Trials (1945-46). The set of letters, previously unexplored in formal scholarship, provides an eye-witness perspective into a critical moment in global legal history and illustrates the danger of contemporary anti-German stereotypes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zhang, C. (2022). Generalization, Detachment, and Stereotypes of “Germans” in the Felton Letters (1945-1946). Stanford Digital Repository. Available at https://purl.stanford.edu/dt942dz7038",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
