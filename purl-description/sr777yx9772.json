    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Team Sirius worked to develop a way for senior citizens to stay healthy both physically and mentally while staying at a senior care facility. The Nosphere is a multi-sensory platform which takes a senior citizen on a journey by using a rotating sphere that has pictures projected on it. This helps senior citizens who are wheelchair bound envision a walking experience. The Nosphere is physically and mentally stimulating for senior citizens.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
