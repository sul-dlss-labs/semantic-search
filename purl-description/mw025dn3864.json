    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"An IPCC special report on the impacts of global warming of 1.5 °C above pre-industrial levels and related global greenhouse gas emission pathways, in the context of strengthening the global response to the threat of climate change, sustainable development, and efforts to eradicate poverty\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Intergovernmental Panel on Climate Change",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This report responds to the invitation for IPCC ' ... to provide a Special Report in 2018 on the impacts of global warming of 1.5°C above preindustrial levels and related global greenhouse gas emission pathways' contained in the Decision of the 21st Conference of Parties of the United Nations Framework Convention on Climate Change to adopt the Paris Agreement\"--PDF Introduction",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Includes the final report, summary, FAQ, drafts, substantive edits, errata, and translations",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Includes bibliographical references",
            "type": "bibliography",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "English with translations into French, Chinese, Russian, Spanish, Arabic, German, Portuguese, and Swedish",
            "type": "language",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Online resource; title from home page (IPCC, viewed on March 28, 2022)",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
