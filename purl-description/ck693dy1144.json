    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The global startup ecosystem is trending with new emerging technologies. This paper provides as\r\nanalysis and evaluation of history and current Silicon Valley ecosystem and comparing with\r\nother emerging ecosystems around the world. The core competency of this paper is also to find\r\nthe defining secret ingredients of Silicon Valley and finding replicable elements that are adopted\r\nby other countries. The method of analysis includes qualitative approaches, such as digging\r\ninsights through existing research papers, articles and interviews to an expert in this field, and\r\nquantitative approaches, such as comparing the number of startup outputs, early stage funding\r\nper startup, and other ratios that could be indicative of success.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dangol, Hira; Pokidko, Natasha; and Hachiya, William. (2017). Exploring Global Startup Ecosystems. Stanford Digital Repository. Available at: https://purl.stanford.edu/ck693dy1144",
            "type": "preferred citation",
