    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The goal of this research was to determine the degree to which Clinical and Translational Science Awards (CTSA) funded institutions incorporated R&R training and support into their translational research infrastructure. We sent an online survey to principal investigators of all CTSA funded institutions and supplemented the survey by institutional website searches. This dataset contains survey responses, as well as information obtained through the website searches. As the raw data included names, emails, and open-ended comments that share confidential information, we are sharing only this anonymized dataset. Original raw data is available only from the authors on the request.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Malički, M., Axfors, C., and Goodman, S. (2023). Anonymized Dataset for Research Rigor and Reproducibility in Research Education: A CTSA Institutional Survey . Stanford Digital Repository. Available at https://purl.stanford.edu/rh435ns0610. https://doi.org/10.25740/rh435ns0610.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
