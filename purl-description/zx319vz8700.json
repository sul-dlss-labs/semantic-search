    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Stanford University Libraries collaborated with Eastside College Preparatory School to provide paid summer internships to 7 local, low‐income, minority, first‐generation college‐ bound students. Our goal is to create successful students, with transferable skills, who love libraries.\r\nOur presentation will detail the logistics required to implement such a program, as well as challenges we encountered. We will discuss programmatic details including interviews; I‐9 documentation and work permits; dress‐codes; dietary considerations; supervision; scheduling; email accounts and communication; employee IDs; timecards; off‐campus events requiring permission slips and conflict‐resolution contingency planning.\r\n",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "SMITH, F. (2013). Lovin' Libraries: Stanford Internship Program. Stanford Digital Repository. Available at https://purl.stanford.edu/zx319vz8700. https://doi.org/10.25740/zx319vz8700.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
