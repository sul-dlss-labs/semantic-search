    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This procedure describes how to conduct an experiment to characterize the pollutant emissions from the combustion of small pieces of woody biomass. This experiment is meant to reproduce at a small scale conditions encountered in wildfires and prescribed fires. The conditions in which the combustion of the sample occurs are finely controlled. This includes the composition, temperature, and velocity of the atmosphere surrounding the burning sample, as well as the heat flux to the sample. The mass loss rate of the sample, as well as the pollutant emissions are measured continuously during the combustion process.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Vignat, G., Toepperwien, K., and Ihme, M. (2023). Biomass combustion and emission studies using an homogeneous burner in conditions representative of wildfires and prescribed fires. Stanford Digital Repository. Available at https://purl.stanford.edu/db494hc9456. https://doi.org/10.25740/db494hc9456.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
