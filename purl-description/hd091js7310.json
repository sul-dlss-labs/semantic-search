    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast explores the social implications of a cappella culture through interviews and surveys, and uses Greek life as a template to outline social phenomena in collegiate a cappella culture. Interviews were done with several people in a cappella groups at Stanford, including, Fleet Street, Everyday People, and Talisman. The podcast seeks to deliver a behind the scenes look at what is really going on behind the performances and music of a cappella groups, and reveals social aspects about the predominant college culture. The interviews were recorded with an external microphone that was attached to an iPhone 5 and recordings were edited on Garageband.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
