    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "For her capstone project, Dalia Hernandez explored the fraught relationship between digital surveillance, the US/Mexico border, the Fourth Amendment rights of migrant workers, and racialized gender identities. This analysis is contextualized against the backdrop of the ACLU's Merchant v. Mayorkas lawsuit filed in 2019 on behalf of 11 travelers whose smartphones and laptops were searched without warrants at the U.S. border. While the lawsuit against the Department of Homeland Security argues that electronic device searches are a violation of the Fourth Amendment, Dalia outlines how the interpretation of this decision has fallen short of implementation and efficacy among border authorities. Furthermore, Dalia argues that the use of digital surveillance is a racialized practice that puts people who cross the border for work or as part of their daily life at increased risk of discrimination and detention. This capstone project was completed as part of the course FEMGEN 152: Gender, Work, and the Global Digital Economy.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hernandez, D. (2024). Digital Surveillance and the Reimagined Borderland: Gender, Work, and the Global Digital Economy. Stanford Digital Repository. Available at https://purl.stanford.edu/fp264nx9045. https://doi.org/10.25740/fp264nx9045.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
