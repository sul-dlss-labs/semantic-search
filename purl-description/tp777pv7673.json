    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "My project A Love Letter to Central American Women and Femmes is about love, care, and healing as resistance against state violence and machismo. This is for the woman and femmes in my life who have shaped and impacted me. Through this project, I will create a collection of letters from Central American women and femmes along the themes of love, care and healing. These love letters will serve as a form of testimonios of the love and resistance of our communities, while uplifting we all individually resist state-violence, machismo, and abuse.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
