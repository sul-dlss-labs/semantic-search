    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This report is concerned with the characteristics of chemical tracer retention in reservoir rock. In most of the previous work done concerning tracer behavior in reservoirs, the retention parameter was not quantified and thus neglected in the material balance calculations. In order to gain a more precise understanding of reservoir tracer behavior, the process of tracer retention in reservoir rock has been investigated.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
