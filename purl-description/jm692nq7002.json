    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This document is an archive of an electronic portfolio (ePortfolio) produced as a\r\ncapstone requirement for the Notation in Science Communication. In their ePortfolios,\r\nNSC students demonstrate how they have met the NSC learning outcomes. These\r\nlearning portfolios detail students’ growth and development as scientists and science\r\ncommunicators rather than showcasing only their best work. ePortfolios are\r\nreviewed and approved by faculty, earning students a special designation on their\r\nofficial Stanford transcript that reflects their science communication acumen.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
