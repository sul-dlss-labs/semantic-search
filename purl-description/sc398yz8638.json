    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This study examines how corruption in higher education (HE) informs the brain drain phenomenon in North Macedonia. Through six interviews with college-educated students who emigrated from the country, the research uncovers the reasons behind their emigration decision and highlights the pervasive nature of corruption within HE. Findings reveal that corruption, along with limited career opportunities and distrust at the systemic level, motivates individuals to seek a better life abroad. The normalization of corruption and a lack of motivation to effect change further contribute to the emigration of highly skilled individuals. The study recommends measures such as establishing integrity units within universities and addressing political party involvement to combat these issues.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Jovcheska, S. (2023). Unveiling Students’ Perspectives: Understanding Brain Drain in North Macedonia Through the Lens of Corruption in Higher Education. Stanford Digital Repository. Available at https://purl.stanford.edu/sc398yz8638. https://doi.org/10.25740/sc398yz8638.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
