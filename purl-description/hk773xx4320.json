    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast explores the Stanford Band's identity, given the many different views of the band by its members and those who oppose it, as well as the rumors and intrigue surrounding the band. It discusses how the band has come to be the way it is, why it incites such anger in people. It features an interview with Roselyn Miller, the band's current PR manager, as well as an anonymous voicemail left for the band by an angry viewer, which is used as Track 1 on the band's album Ultrasound. It also includes many clips of the band playing songs such as Mars, Golgi Apparatus, and All Right Now.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
