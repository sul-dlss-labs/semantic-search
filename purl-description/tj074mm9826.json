    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"Walking the Lifelong Tightrope examines the striking changes in California's economy over the past decade and the implications of this transformation for the state's working families. The report details how workers at all income levels are increasingly vulnerable to rapid changes in our volatile, information-based economy and how inequality has become more and more entrenched in California's economic structure.\"--Working Partnerships USA website.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
