    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Word Explorer is a web-based game that supports teachers in using morphology (the study of the structure of words) to help students in grades 3-6 understand the complex vocabulary needed to succeed in middle school and beyond. By constructing words from bases, prefixes, and suffixes and then connecting them to meaning, students improve their ability to decipher multisyllabic words, recognize them automatically, and understand their meanings. Reading research indicates these skills are necessary for successful reading comprehension.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Murray, T. (2022). Word Explorer Masters Project Report and Video. Stanford Digital Repository. Available at https://purl.stanford.edu/kb422zs8425",
