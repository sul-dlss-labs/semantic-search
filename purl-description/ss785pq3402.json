    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"The GSREF program has been developed to organize, store, and retrieve bibliographic citations. The program allows the user to store a bibliographical citation with keywords that allow the citation to be recalled later by content (including author), keyword(s) or reference number. If references are filed by reference number, GSREF provides a quick, convenient filing system. The citations are always retrieved in an alphabetic sequence and can be printed or stored in a publication style text file for direct inclusion in a report prepared using a word processing system. Version 4.0 adds edit capability and capability for annotation of citations to the previously released Version 3.1, Open File Report 86-0186.\"",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
