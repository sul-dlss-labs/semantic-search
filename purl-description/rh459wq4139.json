    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Jessica Zhu's capstone project was a comparative analysis of transitional justice processes across the countries of the former Yugoslavia. This paper surveyed the different approaches taken by Serbia, Montenegro, Bosnia and Herzegovina, Croatia and Kosovo, as well as the International Criminal Tribunal for the former Yugoslavia. It looked at national war crimes trials, reparations programs, social services, educational narratives, etc. and concluded that transitional justice efforts have not brought justice or reconciliation to the former Yugoslavia, where such initiatives face insurmountable obstacles from their weaponization by political actors, persisting ethnic tensions in the region and an over-reliance on retributive justice.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Zhu, J. (2024). Transitional Justice in the Former Yugoslavia. Stanford Digital Repository. Available at https://purl.stanford.edu/rh459wq4139. https://doi.org/10.25740/rh459wq4139.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
