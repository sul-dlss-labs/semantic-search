    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The NuCar Sound System allows for cars to automatically filter the best music playlist ready for any situation drivers and passengers find themselves in. Anytime you enter a car, the system has the proper music ready for your enjoyment and the enjoyment of any other passengers. This system bases its music playlist on four different components of the people in the car: heart rate, voice, visual, and number of occupancy.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Lyons, Wayne and Melton, Larry and Randle, Chasson and Taylor, Stepfan. (2013). The NuCar Sound System. Stanford Digital Repository. Available at http://purl.stanford.edu/zp407df9737.",
