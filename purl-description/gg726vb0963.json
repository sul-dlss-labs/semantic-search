    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This poster summarizes a mixed-methods research project to understand the mindsets and attitudes of Black content moderators, specifically in the Reddit platform. This research aims to showcase the need for diversity in content moderation teams, and aims to form recommendations to CEOs of social media companies on best practices for increasing diversity.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
