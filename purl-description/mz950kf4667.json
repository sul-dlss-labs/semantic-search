    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This dataset contains 400 EEG session files recorded from pairs of participants across 200 psychotherapy sessions. Recordings from a given session were taken either from a client in individual therapy, along with the therapist; or from both members of a couple participating in couple therapy, with therapist present but not having EEG recorded. Selected sessions are also accompanied by human-coded assessments of emotional states of the clients. All data are anonymized and coded with client identifier, therapist identifier, session number, emotion coder identifier (where applicable), and data type. EEG files are published in Matlab (.mat) format, and each file is up to 2GB in size. A compressed file of emotion codings contain Matlab (.mat) files, totalling around 70KB in size.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Patrick Suppes, Michelle U. Nguyen, Duc T. Nguyen, Cynthia Nguyen, Margot Tuckner, and Marcos Perreau Guimaraes (2015). Suppes Brain Lab Psychotherapy EEG Dataset. Stanford Digital Repository. Available at: http://purl.stanford.edu/mz950kf4667",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
        }
