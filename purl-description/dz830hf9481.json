    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "My subject is a crucial episode in the story of how historical explanation fell out of favor as an element of naturalist\r\nunderstanding: how history found itself banished from science.  It involves Jean-Baptiste Lamarck, the Romantic- and Revolution-era French naturalist who coined the term \"biology\" and offered the first theory of evolution, and focuses upon his relations with Napoleon.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Riskin, J. (2023). The Naturalist and the Emperor, a Tragedy in Three Acts; or, How History Fell Out of Favor as a Way of Knowing Nature. Stanford Digital Repository. Available at https://purl.stanford.edu/dz830hf9481. https://doi.org/10.25740/dz830hf9481.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
