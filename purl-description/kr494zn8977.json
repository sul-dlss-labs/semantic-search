    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "\"This is the fourth annual report of the Secretary General of the Council of Europe on the state of democracy, human rights and the rule of law in Europe. As with previous reports, the five chapters look at the key building blocks of democratic security: efficient, impartial and independent judiciaries; freedom of expression; freedom of assembly and freedom of association; democratic institutions; and inclusive societies. The report's analysis of Council of Europe member states' strengths and weaknesses in these areas can be used to assess their resilience to the challenges posed by populism.\"--Document home page.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "report by the Secretary General of the Council of Europe.",
            "type": "statement of responsibility",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
