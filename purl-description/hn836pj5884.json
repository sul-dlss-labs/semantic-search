    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "It was the goal of our study to analyse differences in title, authorship, abstracts, article text, tables, figures, and references of first ever nursing studies posted as preprints on medRxiv’s nursing subsection and SSRN's Nursing Network. We sampled all preprints posted on medRxiv nursing subsection since its inception till February 2021, and as comparator we analysed the same number of preprints first posted on SSRN Nursing Network. Differences between preprints and the journal publications were determined using quantitative and qualitative assessment. Results are reported as number and percentage of document pairs with found differences. Differences between servers were analysed with a series of chi-squared tests.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Mikulic, I., Puharic, D., and Malički, M. (2024). Dataset and Statistical Outputs for Differences between First Ever Nursing Studies Posted as Preprints on medRxiv or SSRN and Published in Peer-reviewed Journals: a Cross-sectional Study. Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/hn836pj5884/version/1. https://doi.org/10.25740/hn836pj5884.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
