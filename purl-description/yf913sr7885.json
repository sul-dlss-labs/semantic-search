    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In DSC #15: Little Miss California Stereotype... and the BY Times, Quinn Dombrowski talks with Dainy Bernstein about the \"BY Times\", a Haredi knock-off of the Baby-Sitters Club series, and they work with Mark Algee-Hewitt to see if the BY Times character who embodies California stereotypes has computationally distinctive speech.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dombrowski, Q., Bernstein, D., and Algee-Hewitt, M. (2024). DSC #15: Little Miss California Stereotype… and the BY Times. Stanford Digital Repository. Available at https://purl.stanford.edu/yf913sr7885. https://doi.org/10.25740/yf913sr7885.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
