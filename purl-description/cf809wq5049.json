    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This project focuses on preventing surface waters and sediment recontamination at Department of Defense (DoD) facilities from stormwater runoff by developing biofilters amended with black carbons (BC) such as biochar and regenerated activated carbon. Stormwater runoff contaminants including polychlorinated biphenyls (PCBs), polycyclic aromatic hydrocarbons (PAHs), per- and polyfluoroalkyl substances (PFASs), and heavy metals can be a major source of recontamination and are a major concern for DoD facilities.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
