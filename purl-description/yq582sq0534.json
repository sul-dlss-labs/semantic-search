    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Severe acute respiratory syndrome coronavirus 2 (SARS CoV-2) is a zoonotic sarbecovirus responsible for the COVID-19 Pandemic. SARS CoV-2 uses a trimeric surface spike protein that undergoes conformational changes to facilitate viral entry and fusion. BG10-19 is a potent SARS-CoV-2 monoclonal antibody (mAb) that engages an epitope on the RBD of the Spike trimer. It is an effective inhibitor of viral entry against early variants of SARS CoV-2, but shows diminished activity against later lineages. We assess the binding ability of BG10-19 to the Receptor Binding Domains (RBDs) of a diverse set of sarbecoviruses to identify viruses BG10-19 may have the capacity to neutralize. Furthermore, we use a structure-guided yeast surface display library with mutations in specific residues of BG10-19 designed to improve binding to sarbecoviruses against a set of RBDs. Our results reveal insights about the current binding breadth of BG10-19 and opportunities to expand said breadth.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sharma, B. and Barnes, C. (2024). Expanding the Breadth of SARS CoV-2 monoclonal antibody BG10-19 across the Sarbecovirus Family. Stanford Digital Repository. Available at https://purl.stanford.edu/yq582sq0534. https://doi.org/10.25740/yq582sq0534.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
