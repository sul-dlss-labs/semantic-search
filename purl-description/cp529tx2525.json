    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Full simulation results for unsteady conduit flow modeling of injection of heterogeneous magma. These are the main results used in the following publication: \"Seismic signatures of fluctuating fragmentation in volcanic eruptions.\"  Coppess, K. R., Lam, F. Y. K., & Dunham, E. M. (submitted 2024)\r\n\r\nResults were generated using the following unsteady conduit flow model implemented by Fredric Y.K. Lam: https://github.com/fredriclam/quail_volcano",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Coppess, K., Lam, F., and Dunham, E. (2024). Simulation results for \"Seismic signatures of fluctuating fragmentation in volcanic eruptions\" -- Coppess et al. Stanford Digital Repository. Available at https://purl.stanford.edu/cp529tx2525. https://doi.org/10.25740/cp529tx2525.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
