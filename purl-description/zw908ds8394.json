    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Jordan Water Model (JWM) is a multi-agent, hydrologic-economic model of Jordan's national water system. The JWM-T extension enables tanker water market analyses. The JWM and JWM-T were developed as part of the Jordan Water Project (JWP) and the FUSE project led by Stanford University.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Yoon, J., Klassert, C., Selby, P., Lachaut, T., Knox, S., Avisse, N., Harou, J., Tilmant, A., and Gorelick, S. (2023). Jordan Water Model (JWM). Stanford Digital Repository. Available at https://purl.stanford.edu/zw908ds8394.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
