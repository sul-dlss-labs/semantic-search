    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "It’s time to reimagine schooling with our neurodiverse students at the center. OneMile helps educators build their knowledge and empathy for neurodiverse students’ experience at school through interviews and shadow experiences, positioning them as teacher-researchers. It also provides the resources and frameworks to engage in these activities within a Professional Learning Community (PLC) of other educators who are doing the same work, translating individual learning into systemic changes. This all helps educators make decisions from the bottom up, grounding their work in empathy for the student experience with the goal of building more supportive learning environments.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Shook, J. (2023). OneMile. Stanford Digital Repository. Available at https://purl.stanford.edu/cc413cf9814. https://doi.org/10.25740/cc413cf9814.",
