    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This comparative case study explores environmental and sustainability education (ESE) in international initiatives from the United Nations and in national education policy in France and the Philippines. Through qualitative analysis of ESE-related policy documents, I find that the global and national models present a similar anthropocentric, instrumentalist perspective on the environment but prioritize different objectives. I argue that similarities between global and national models, along with the national documents’ references to international policy drivers, reflect the UN’s influence on national ESE policy, but that differences between the cases may be driven by national priorities.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Shipan, R. (2022). “A Balancing Act” Between Global Mandates and National Interests: Environmental and Sustainability Education Policy from the United Nations, France, and the Philippines. Stanford Digital Repository. Available at https://purl.stanford.edu/dv571rv5612",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
