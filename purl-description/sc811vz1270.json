    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Confocal microscopy of paraventricular hypothalamus (PVH) sections from mice raised at 22°C or 30°C were stained with RNAScope fluorescent probes for corticotropin-releasing hormone (Crh). Additionally, videos to ascertain the ex vivo motility of colons from mice raised at 22°C or 30°C are provided. Detailed methods can be found in the associated publication.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Han, A., Hudson-Paz, C., Robinson, B., Garrison, J., Kaltschmidt, J., Bhatt, A., and Monack, D. (2024). 22°C vs 30°C Mouse Ex Vivo Colon and PVH Microscopy Data. Stanford Digital Repository. Available at https://purl.stanford.edu/sc811vz1270. https://doi.org/10.25740/sc811vz1270.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
