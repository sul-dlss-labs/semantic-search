    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This repository contains the Satellite Hardware-In-the-loop Rendezvous Trajectory (SHIRT) dataset which consists of two rendezvous trajectory scenarios (ROE1 and ROE2) in Low Earth Orbit (LEO) created from two different image sources. One is the OpenGL-based computer graphics renderer to create the synthetic images, and the other is the TRON facility at the Space Rendezvous Laboratory (SLAB) of Stanford University which illuminates a satellite mockup model with the Earth albedo light boxes to create the lightbox images. In ROE1, the servicer maintains the along-track separation typical of a standard v-bar hold point while the target spins about one principal axis, whereas in ROE2, the servicer slowly approaches the target tumbling about two principal axes. The sequential images of the SHIRT dataset can be used to evaluate the robustness of machine learning models and vision-based navigation filters over time across domain gap.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Park, T. H. and D'Amico, S. (2022). SHIRT: Satellite Hardware-In-the-loop Rendezvous Trajectories Dataset. Stanford Digital Repository. Available at https://purl.stanford.edu/zq716br5462. https://doi.org/10.25740/zq716br5462.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
