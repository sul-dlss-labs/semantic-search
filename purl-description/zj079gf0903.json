    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "City Council and other public meeting notes offer a trove of information informing a city’s history, development, and actions. Taken together, they can map a timeline of development projects and legislation. However, this longitudinal perspective is difficult to obtain unless one is actively following a project because the meeting minutes and agendas are posted as individual PDFs and, in its current form, is difficult to perform a full-text search on. If I wanted to search for the city’s recent actions with relation to Palantir or follow the development of an affordable housing project, I would either have to know in advance which city council meetings were related to the query in question or skim through the entire trove of meeting minutes to find what I am looking for. Luckily, technology provides us with a solution.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
