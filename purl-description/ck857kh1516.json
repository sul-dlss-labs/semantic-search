    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ink and Insights is a collection of zines created by Vanessa Sarmiento encapsulating her experience working with Filipino Advocates for Justice in the summer of 2024. The goal of this project is to allow others to step into the world of what community work entails and the wonderful stories and perspectives that contribute to social justice. This collection includes written reflections, images, and poems.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sarmiento, V. (2024). Ink and Insights . Version 1. Stanford Digital Repository. Available at https://purl.stanford.edu/ck857kh1516/version/1. https://doi.org/10.25740/ck857kh1516.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
