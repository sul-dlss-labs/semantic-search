    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This repository makes data and code available to readers of Ivanov et al. (PNAS 2020), and relies on that published paper for context. Three archives are included in this collection. “Data in Figures 1-3” and “Data in Supplementary Figures S1-S9” contain all the data presented in figure panels in the main text and supplementary appendix, respectively. “RBT Analysis Code” includes MATLAB scripts used to process raw RBT data, together with a sample file enabling a demonstration calculation. The contents are further described in readme files contained within each archive.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
