    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This study, undertaken by researchers at the University of California, Berkeley, and Working Partnerships USA, finds that just a barely majority of adults likely will have job-based health insurance by 2010, with middle-income adults facing the sharpest coverage decline and lower-income adults being largely priced out of the market.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Arindrajit Dube, Ph.D. and Ken Jacobs, UC Berkeley Center for Labor Research and Education [and 3 others].",
