    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The Diversity Outbred (DO) mouse population is a panel of genetically unique outbred individuals with high levels of genetic variation. This affords an opportunity to perform experiments in a well-established animal model while taking advantage of the wide range of natural genetic diversity. Here, we promote this unique mouse resource for studies in disease dynamics because it allows for genetic examination of mechanisms in mice exhibiting distinct pathologies during each stage of infection. This approach is based on quantitative trait locus mapping: identifying specific genome regions associated with phenotypic variance in traits of interest.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
