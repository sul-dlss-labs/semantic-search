    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This is a set of matlab .mat files along with a readme file that describes the various variables. These data are described in the paper, \"Influence of kelp forest biomass on nearshore currents,\" by Monismith et al. submitted to JGR Oceans in December 2021, and in revised form in April 2022.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Monismith, S., Woodson, C., Alnajjar, M., Micheli, F., Bell, T., Boch, C., Hernandez, A., and Vazquez-Vera, L. (2022). Physical oceanographic data collected between March 2013 and Sept 2015 in nearshore regions of Isla Natividad. Stanford Digital Repository. Available at https://purl.stanford.edu/pm013yw3772",
