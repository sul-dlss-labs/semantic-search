    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This artifact provides data to train machine learning models for autonomous aircraft maneuvers. In particular, it provides images from a camera mounted on a simulated aircraft's wing coupled with corresponding state estimation, such as distance along a run-way or angle of deviation from a run-way center-line. Using this data, based on the X-Plane Simulator, we have trained machine learning models for the NASA University Leadership Initiative on Safe Aviation Autonomy under PI Dr. Pavone with multi-institution collaborators.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Katz, Sydney M. and Corso, Anthony and Chinchali, Sandeep and Elhafsi, Amine and Sharma, Apoorva and Kochenderfer, Mykel J. and Pavone, Marco. (2021). NASA ULI Aircraft Taxi Dataset. Stanford Digital Repository. Available at: https://purl.stanford.edu/zz143mb4347",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
            "note": [],
            "appliesTo": []
