    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This deposit contains nitrogen and oxygen stable isotopic data from nitrate, nitrite, and nitrous oxide collected on research cruises to the Eastern Tropical South Pacific Ocean in 2010 and 2011. The accompanying hydrographic (temperature, salinity, and density) and nutrient data are also provided.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Gluschankoff, N., Santoro, A., and Buchwald, C., Casciotti, K.L. (2022). Eastern Tropical South Pacific Ocean Nitrate, Nitrite, and Nitrous Oxide isotope data from 2010 and 2011 cruises. Stanford Digital Repository. Available at https://purl.stanford.edu/sc709fd6894. https://doi.org/10.25740/sc709fd6894.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
