    "geographic": [],
    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This workbook provides monitoring data from a pilot-scale ozone/open-water wetland treatment system for reverse osmosis concentrate from the Silicon Valley Advanced Water Purification Center (San Jose, CA). Water quality analyses included common water quality parameters, nutrients, trace metals, and trace organics. These analyses were performed by UC Berkeley, Stanford University, Valley Water's Water Quality Lab, and a contract lab (Eurofins). Functional gene analyses (qPCR) were conducted at Colorado School of Mines for samples of the biomat microbial community that developed in the open-water wetlands. Results are consolidated in Excel and .csv formats.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Scholes, Rachel C., King, Jack F., Vega, Michael A., Sharp, Jonathan O., Mitch, William A., Sedlak, David L. (2020). Monitoring Data from Pilot-Scale Open-Water Unit Process Wetland Treatment of Reverse Osmosis Concentrate from Water Reuse. Stanford Digital Repository. Available at: https://purl.stanford.edu/mp388hh4436 https://doi.org/10.25740/12qf-5243",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
