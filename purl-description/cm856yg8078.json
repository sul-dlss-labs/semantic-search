    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast gives a brief overview of the history of rowing and possible reasons for why the sport is currently unpopular in the United States of America. It then goes on to explore why, given the pain and thanklessness of the sport, people choose to dedicate their lives to it. This investigation is done primarily through interviews with Stanford rowing coach Craig Amerkhanian as well as current rowers Charlie Walker, Ryan O'Rourke, and Erik Holmvik. The piece highlights the benefits that the sport provides to those who undertake its burden.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
