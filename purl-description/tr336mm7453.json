    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The poster provides information about how Stanford Libraries is using an open source task management application called Goobi now integrated locally with the Stanford Digital Repository to create an end-to-end workflow to streamline task management, production metrics gathering, and the hand-off of digitized content to the repository for preservation and access. The poster provides a visual diagram of the system, and explains why the product Goobi was selected, what a typical workflow looks like, how the system integration is achieved, and what we have learned as a result of this work.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Frost, H. and Mangiafico, P. (2019). Integrating Digitization Workflow with the Stanford Digital Repository. Stanford Digital Repository. Available at https://purl.stanford.edu/tr336mm7453. :doi:",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
