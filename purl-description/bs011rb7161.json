    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "We built upon the work of a Bay Area High School to address hate speech on their campus. We supported their efforts by analyzing the implementation of the policy. Through interviews and observations, we identified possible elements for disrupting hate speech and provided a framework for understanding what factors are influencing hate speech. We hope that this report serves as both a summary of findings and a guide for continuing this work.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Hernandez, A. and Bynum, J. (2024). Facing the Challenge of Hate SpeechPolicy Considerations from a Bay Area High School. Stanford Digital Repository. Available at https://purl.stanford.edu/bs011rb7161. https://doi.org/10.25740/bs011rb7161.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
