    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Artist Gunner Dongieux speaks to the thematic underpinnings of his expansive 25-painting installation in OK Corpse, the 2022 Art Practice Undergraduate Honors Thesis Exhibition. Describing paintings rich in absurdist humor and pop-cultural puns, Dongieux ponders how one makes sense of a nonsensical world, exploring the tension between his desire to form logic through depiction, and his subject’s inherent absurdity. \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Dongieux, G. (2022). Making Sense of a Nonsensical World. Stanford Digital Repository. Available at https://purl.stanford.edu/vy853hr9835",
            "type": "preferred citation",
            "identifier": [],
