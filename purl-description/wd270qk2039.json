    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In 2011 DensityDesign, a research lab at the Politecnico di Milano began working with the Mapping the Republic of Letters team at Stanford and this ‘narrative panorama’ is one of the results of the multi-year collaboration.\r\nIt represents the network of people who contributed to the project from its birth in 2008 and through events planned into April of 2013. It captures the subjects of the various parts of research, related events, places and milestones: the model of the panorama, as well as the visual tone of the visualization, concurs to the narrative level that tells how all these elements shape the story through an extended network of connections.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Graffieti, M. (2012). Mapping the Republic of Letters, A Narrative Panorama. Stanford Digital Repository. Available at https://purl.stanford.edu/wd270qk2039",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
