    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast explores the meaning of having it all in a new light. First, it investigates how the Outdoor House was created at Stanford by a team of Stanford students determined to make it their all. Then, it explores the personal stories of Olympic athletes who share their experiences of what they're willing to risk to have it all. Finally, it explores the origin and meaning of the phrase 'having it all' through a women's liberation perspective.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
