    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This deposit contains stable isotope measurements of nitrate (15NNO3 and 18ONO3) from the 2013 US GEOTRACES Eastern Pacific Zonal Transect (GP16) analyzed in Stanford Stable Isotope Laboratory. The cruise extended through the subtropical south Pacific, from the Peru upwelling system to Tahiti, in the oligotrophic waters of the south Pacific subtropical gyre.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Casciotti, Karen and Peters, Brian. (2018). GEOTRACES GP16 Nitrate isotope data. Stanford Digital Repository. Available at: https://purl.stanford.edu/hy383hj0444",
