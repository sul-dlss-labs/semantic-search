    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Through their research, Team Audi learned that the cars of the future will have to incorporate features that will help drivers drive safely while connecting to email, social media and calling features. Team Audi has developed Syntact, which is an interface which incorporates touch and gesture communication in its use. The driver will be free from pressing buttons and instead can use gestures and touch to open and use applications. The Syntact also incorporates cameras into a steering wheel to track the driver’s fingers around the wheel.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Bhandari, Rishabh; Lin, Kristin; Steber, Scott; Kerschbaum, Phillip; Lenker, Thomas; Wacker, Phillip and Wenzel, Fritz. (2012). Syntact. Stanford Digital Repository. Available at: http://purl.stanford.edu/vf728sh2937",
            "type": "preferred citation",
