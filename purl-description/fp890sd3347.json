    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis is a reported piece of journalism. It includes data that I gathered through a survey sent out to artistic swimmers in the United States. My analysis of this data showed that 25 percent of artistic swimmers sustained at least one concussion during their careers and that 15 percent might have sustained one or more, documenting the prevalence of concussions in artistic swimming. The article features four former elite artistic swimmers who sustained concussions and photographs of an award-winning team.\r\n\r\nIn addition to the article and photographs, there is a 360-degree video experience that showcases the risks below the surface. The video is available at this link: https://youtu.be/EhnrB26rRFg",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Brassil, Gillian Rose (2019). Risk below the surface: Concussions in artistic swimming. Stanford Digital Repository. Available at: https://purl.stanford.edu/fp890sd3347",
            "type": "preferred citation",
            "identifier": [],
