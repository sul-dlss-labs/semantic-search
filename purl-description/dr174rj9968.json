    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "A genetic dataset of Acropora hyacinthus and Acropora cytherea corals collected from archipelagos across the Pacific Ocean that were analyzed in Sheets et al. 2018 Coral Reefs. The dataset contains single nucleotide polymorphism genotypes at 185 unphased nuclear loci and 14 linked mitochondrial loci for 765 coral samples from the two species complexes. In this study, we assigned each coral sample to one of eight cryptic genetic species detected in the Acropora hyacinthus (six species labelled Ha-Hf) and Acropora cytherea (two species labelled C1-C2) complexes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Sheets, E.A., Warner, P.A. and Palumbi, S.R. (2018). Data from: Sheets et al. (2018) \"Accurate population genetic measurements require cryptic species identification in corals\". Stanford Digital Repository. Available at: https://purl.stanford.edu/dr174rj9968",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
