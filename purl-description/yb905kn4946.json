    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "The datasets associated with the publication entitled “Coupled Transport, Reactivity, and Mechanics in Fractured Shales” is attached. This includes imaging datasets acquired on a naturally fractured Wolcamp sample using micro- and clinical-CT instruments. Clinical-CT scans of the sample were acquired at vacuum, brine-saturated, pH 2 brine-saturated at 19 days, and pH 2 brine-saturated at 74 days. Clinical CT scans tracked porosity alterations in the sample due to pH 2 brine injection. Micro-CT scans were obtained at dry-state before and after low pH brine flow through the sample. The voxel dimensions of the 3D tomograms are (27×27×27) μm3 and (195×195×625) μm3 for micro- and clinical-CT, respectively. An additional 'Readme.txt' file is provided that contains detailed description of each dataset including the key parameters set for the CT instruments.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Murugesu, M., Vega Martin, B., Ross, C., Kurotori, T., Druhan, J., and Kovscek, A. (2024). Dynamic X-ray CT Imaging of Reaction-induced Processes in a Naturally Fractured Wolfcamp Shale. Stanford Digital Repository. Available at https://purl.stanford.edu/yb905kn4946. https://doi.org/10.25740/yb905kn4946.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
