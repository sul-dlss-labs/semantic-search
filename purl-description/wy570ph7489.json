    "language": [],
    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "In the current study, we present high-pressure high-CO2-loading IDT studies with H2S addition at 100atm and temperatures of 1000-1200K for syngas. This work also provides important improvements in certain key reactions pertinent to sCO2 environments. To best of the authors knowledge, this work presents the first syngas IDT measurements with H2S for these conditions.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Biswas, P., Shao, J., Choudhary, R., Davidson, D., and Hanson, R. (2022). Ignition delay time measurements and model improvements of syngas with H2S in supercritical CO2 systems. 2022 WSSCI Spring Technical Meeting, Organized by the Western States Section of the Combustion Institute March 21–22, 2022, Stanford University, Stanford, CA",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
