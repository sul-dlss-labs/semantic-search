    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Second-order diffraction provides a useful tool for modeling nonlinear wave forces on large volume offshore structures. For purposes of assessment, design , or general characterization of behavior, corresponding tools are needed to study the response of structures subjected to these forces. This document is an overview of modeling and analysis capabilities developed for second-order systems in the Reliability of Marine Structures program at Stanford University. The implementation of these capabilities in a program called TFPOP is described, and an example of its application to a slack-moored floater is given.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Ude, T. C.. (1994). TFPOP: A Program for Analysing Second-Order Load and Response Models of Offshore Structures. Reliability of Marine Structures Program Technical Report RMS-15. Stanford Digital Repository. Available at: http://purl.stanford.edu/df755sh1570",
            "type": "preferred citation",
            "identifier": [],
            "displayLabel": "Preferred Citation",
