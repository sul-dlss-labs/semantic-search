    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This project, led by the Data Nutrition Project and commissioned by the New Commonwealth Fund, investigates funding disparities between BIPOC-led and non-BIPOC-led nonprofit organizations in Massachusetts over the past decade. Using data from Candid, IRS 990 filings, and the Paycheck Protection Program (PPP), the analysis revealed that minority-led organizations consistently received a smaller proportion of total funding. A noticeable spike in funding in 2021, likely tied to increased awareness of racial justice movements, was followed by a return to previous funding levels in 2022. Due to gaps in leadership demographic data, estimates of minority-led organizations were derived through keyword searches. While this pilot study highlights funding inequities, the limitations of available datasets underscore the need for more comprehensive data collection efforts to inform future research and policy recommendations.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Langevine, S., Chmielinski, K., Ren, K., Durso, L., and Taylor, M. (2024). Equity in Funding: Data Project. Stanford Digital Repository. https://doi.org/10.25740/ht498gd3974.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
