    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Contains the data used to generate plots in \"Prevalence of Neural Collapse during the terminal phase of deep learning training\" by Papyan, Han, and Donoho in PNAS 2020; and \"Neural Collapse Under MSE Loss: Proximity to and Dynamics on the Central Path\" by Han, Papyan, and Donoho in ICLR 2022. \r\n\r\nUsing Tableau Desktop (free for academics), one can open the plots by simply opening the pre-packaged Tableau file (.tbx). The raw data is in the corresponding CSVs. Also, contains the .gif used to generate Figure 1 of the paper.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Han, X. Y. and Papyan, Vardan and Donoho, David L. (2020). Data for \"Prevalence of Neural Collapse during the terminal phase of deep learning training\" and \"Neural Collapse Under MSE Loss: Proximity to and Dynamics on the Central Path\". Stanford Digital Repository. Available at: https://purl.stanford.edu/ng812mz4543",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
