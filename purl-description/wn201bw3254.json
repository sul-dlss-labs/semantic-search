    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Letter (signed Pedro de Lemos) pertains to the proposed donation of a painting to the Stanford Museum, a suggestion that the Museum collect the work of early California artists, and the efforts of Lemos and his wife in sponsoring California art projects. Lemos misspelled Jacobson’s name as Jacobsen on the letter.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Administrative transfer, 1994.",
            "type": "acquisition",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Pedro J. Lemos, painter, etcher and illustrator, was Director of the Stanford Museum of Art from 1917 until 1945. At the time of the letter, David S. Jacobson was the executive assistant to the President of the University.",
            "type": "biographical/historical",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
    ],
