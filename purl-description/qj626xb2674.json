    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This podcast is meant to inform people about the general structure and functions of the foster care system of America, while also introducing them to the stories behind these invisible children. Aside from using my own story, I also interviewed a social worker, his supervisor, as well as a former foster youth who now works at a non profit organization for foster children. For background music I used snippets from songs namely by Jhene Aiko and Duke Ellington, as well as original renditions of songs by Brenda Lee and Scott Joplin.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
