            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Reed, Kelsey; Arévalo, César; Tallman, Avery; MacAulay, Jennifer; Elsewify, Omar; Meier, Dominik; Wendt, Leo; Justen, David. (2021). Mapd. Stanford Digital Repository. Available at: https://purl.stanford.edu/tf608vx1486",
            "type": "preferred citation",
