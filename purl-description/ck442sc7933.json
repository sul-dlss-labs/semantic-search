    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Chapter 13 in \"The Bloomsbury Handbook to the Digital Humanities\", this piece argues that learning to code plays an outsized role in digital humanities scholars' preoccupations, relative to its utility in developing digital humanities projects. Instead, it argues that scholars should instead focus on understanding the workflows of their projects in their entirety -- including their project management and collaboration aspects.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
