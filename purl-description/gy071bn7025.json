    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This thesis aims to identify the effects of political solicitation on electoral outcomes. Political solicitation is the process by which party affiliates persuade voters at the polls to vote in accordance with their ideology, often using sample ballots and carefully crafted rhetoric. Research indicates the psychological effectiveness of \"last-minute\" persuasion, but little is known about whether or not these efforts actually persuade people to switch their vote. Using variation in the timing of state bans on political solicitation, a difference-in-differences analysis is performed to evaluate the effect of political solicitation on electoral outcomes.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "Beyene, A. (2024). From Outreach to Outcome: The Effect of Political Solicitation On Electoral Results. Stanford Digital Repository. Available at https://purl.stanford.edu/gy071bn7025. https://doi.org/10.25740/gy071bn7025.",
            "type": "preferred citation",
            "identifier": [],
            "note": [],
            "appliesTo": []
        }
