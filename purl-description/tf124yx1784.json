    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This shapefile was created from the Clowns of America, International Membership Database (anonymized) obtained in 2007 from Clowns of America, International, for use in teaching.  It was created by geocoding the ZipCode field of the original table, using OpenRefine and the Geonames.org PostalCodes API. Attributes include those from the original data table ('City', 'ZipCode', 'Clown_Name', and 'Country'), as well attributes added during the geocoding process ('admname1','adm1','adm2','placname','longitude','latitude') and an attribute 'Clown-Na_1' which represents the values in the 'Clown_Name' attribute field after a \"Cluster and Edit\" operation, performed in OpenRefine to collapse values so that \"Co Co\" or \"Co-Co\" both are clustered and edited to become \"CoCo\" for use in name frequency analysis.",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
