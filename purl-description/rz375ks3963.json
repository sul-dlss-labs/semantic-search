    "note": [
        {
            "structuredValue": [],
            "parallelValue": [],
            "groupedValue": [],
            "value": "This deposit focuses on providing a nonprofit, Peninsula Bridge, insight and recommendations on how they can improve their services and programs for first-generation, low-income middle school and high school students. This includes a report that highlights strengths and weaknesses of the organization, a list of recommendations, a guide on how to work with first-generation, low-income students, and a milestone tracker to help college students think about the workforce during their time in undergraduate. ",
            "type": "abstract",
            "identifier": [],
            "note": [],
            "appliesTo": []
        },
